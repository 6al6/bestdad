{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}

<section class="landing-letter landing-letter--{{ section.id }}">
  <div class="landing-letter__inner">
    {%- if section.settings.avatar != blank or section.settings.heading != blank -%}
      <div class="landing-letter__intro">
        {%- if section.settings.avatar != blank -%}
          {{-
            section.settings.avatar
            | image_url: width: 320
            | image_tag: class: 'landing-letter__avatar', width: 80, height: 54, loading: 'lazy', widths: '160, 240, 320', sizes: '80px', alt: section.settings.avatar.alt
          -}}
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-letter__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="landing-letter__body landing-marker">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .landing-letter--{{ section.id }} {
    --lm-color: color-mix(in srgb, {{ section.settings.marker_color }} {{ section.settings.marker_opacity }}%, transparent);
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  }
  .landing-letter__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 600px;
    margin-inline: auto;
    padding: 52px 18px 40px;
  }
  .landing-letter__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .landing-letter__avatar {
    display: block;
    box-sizing: border-box;
    width: 80px;
    height: 54px;
    border: 1px solid {{ section.settings.avatar_border_color }};
    border-radius: 8px;
    object-fit: cover;
  }
  .landing-letter__heading {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 36px;
    line-height: 1.05;
    text-align: center;
    text-transform: none;
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .landing-letter__body {
    font-size: 17px;
    line-height: 1.5;
  }
  .landing-letter__body p { margin: 0 0 1.5em; }
  .landing-letter__body p:last-child { margin-bottom: 0; }
  .landing-letter__body strong { font-weight: 700; }
{% endstyle %}

{% schema %}
{
  "name": "Landing: Letter",
  "tag": "section",
  "class": "landing-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Photo above heading",
      "info": "Landscape crop, about 80 x 54."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "“Nisem ekspert za vzgojo. Za neumnosti pa sem kar dobro usposobljen.”"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "info": "Use Underline to highlight a phrase with the marker color. Use Bold and Italic for emphasis.",
      "default": "<p><strong>Jaz nisem strokovnjak za vzgojo. Niti približno.</strong> Sem fotr dveh punc in ukvarjam se z enakimi težavami kot drugi fotri: z zbeganostjo, nebogljenostjo, pretvarjanjem, da vem, kaj delam, in občutkom, da bom vse pomembno zamudil.</p><p>Znam pa nekaj drugega. Že večino življenja <u>iz običajnih situacij delam zgodbe, predstave in neumnosti, ob katerih se ljudje zabavajo.</u></p><p>Zato sem ustvaril komplet Jaz sem najboljši fotr na svetu. Ne zato, da bi fotrom razlagal, kako morajo vzgajati svoje otroke, ampak da nam ob vprašanju <strong>»<em>Kaj bomo danes počeli?</em>« ne bi bilo treba vedno znova izumljati odgovora.</strong></p><p><u>Misije sem preizkusil doma. Na lastnih otrocih.</u> Nekatere so se končale s smehom, druge z neredom, najboljše pa z obojim. Iz njih so nastali trenutki, o katerih se še vedno pogovarjamo.</p><p>Če ti ta komplet <strong>pomaga, da se s svojim otrokom večkrat pojaviš, nekaj izpelješ in si zares zraven, je opravil svoje delo.</strong> Če zaradi tega za nekaj minut postaneš še družinski heroj, pa tudi ne bom protestiral.</p>"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "avatar_border_color", "label": "Photo border", "default": "#000000" },
    { "type": "color", "id": "marker_color", "label": "Marker highlight", "default": "#ee614c" },
    {
      "type": "range",
      "id": "marker_opacity",
      "label": "Marker opacity (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    },
    { "type": "header", "content": "Wavy divider" },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top divider color",
      "info": "Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Bottom divider color",
      "info": "Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        { "value": "waves-1-patterned_1200x20", "label": "Waves 1 (small)" },
        { "value": "waves-2-patterned_1200x43", "label": "Waves 2 (medium)" },
        { "value": "waves-3-patterned_1200x84", "label": "Waves 3 (large)" },
        { "value": "zig-zag-2-patterned_1200x37", "label": "Zig-zag" },
        { "value": "circles-2-patterned_1200x35", "label": "Circles" },
        { "value": "spikes-1-patterned_1200x132", "label": "Spikes" }
      ],
      "default": "waves-1-patterned_1200x20"
    },
    { "type": "checkbox", "id": "divider_animate", "label": "Animate divider", "default": true }
  ],
  "presets": [{ "name": "Landing: Letter" }]
}
{% endschema %}
