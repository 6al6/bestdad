default":true},{"type":"textarea","id":"text_2","label":"Text","default":"Tear it out\nFollow the script\nStick the proof\nBrag responsibly"},{"type":"range","id":"tilt_2","label":"Tilt","min":-8,"max":8,"step":0.5,"unit":"°","default":2.5},{"type":"color","id":"band_color_2","label":"Band","default":"#2b2d45"},{"type":"color","id":"band_text_color_2","label":"Text","default":"#fef1d5"},{"type":"color","id":"band_border_color_2","label":"Border","default":"#2b2d45"},{"type":"color","id":"separator_color_2","label":"Separator","default":"#ee614c"},{"type":"header","content":"Section"},{"type":"color","id":"background_color","label":"Background","default":"#fef1d5"},{"type":"range","id":"padding","label":"Space above and below","min":0,"max":120,"step":4,"unit":"px","default":40},{"type":"text","id":"anchor_id","label":"Anchor ID","info":"Lets buttons jump here, e.g. gift → link to #gift."},{"type":"header","content":"Wavy divider"},{"type":"color","id":"divider_top_color","label":"Top divider color","info":"Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."},{"type":"color","id":"divider_bottom_color","label":"Bottom divider color","info":"Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."},{"type":"select","id":"divider_style","label":"Divider style","options":[{"value":"waves-1-patterned_1200x20","label":"Waves 1 (small)"},{"value":"waves-2-patterned_1200x43","label":"Waves 2 (medium)"},{"value":"waves-3-patterned_1200x84","label":"Waves 3 (large)"},{"value":"zig-zag-2-patterned_1200x37","label":"Zig-zag"},{"value":"circles-2-patterned_1200x35","label":"Circles"},{"value":"spikes-1-patterned_1200x132","label":"Spikes"}],"default":"waves-1-patterned_1200x20"},{"type":"checkbox","id":"divider_animate","label":"Animate divider","default":true}],"presets":[{"name":"Landing FX: Marquee"}]}{% endschema %}
