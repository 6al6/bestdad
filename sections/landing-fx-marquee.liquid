{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}
{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>

{%- capture lfx_star -%}
  <svg viewBox="0 0 1 1" aria-hidden="true" focusable="false"><path d="{% render 'landing-fx-shape', name: 'spiky' %}"/></svg>
{%- endcapture -%}
{%- capture lfx_burst -%}
  <svg viewBox="0 0 1 1" aria-hidden="true" focusable="false"><path d="{% render 'landing-fx-shape', name: 'burst' %}"/></svg>
{%- endcapture -%}

<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="lfx lfx-marquee lfx-marquee--{{ section.id }}{% if section.settings.show_second %} has-second{% endif %}">
  <div class="lfx-marquee__stack">
    {%- for band in (1..2) -%}
      {%- liquid
        if band == 1
          assign band_text = section.settings.text
          assign band_direction = section.settings.direction
          assign band_class = 'lfx-band--one'
        else
          unless section.settings.show_second
            continue
          endunless
          assign band_text = section.settings.text_2
          assign band_direction = 'right'
          if section.settings.direction == 'right'
            assign band_direction = 'left'
          endif
          assign band_class = 'lfx-band--two'
        endif
        assign items = band_text | newline_to_br | split: '<br />'
      -%}
      <div
        class="lfx-band {{ band_class }}{% if section.settings.spin_separator %} is-spin{% endif %}"
        data-lfx-marquee
        data-speed="{{ section.settings.speed }}"
        data-direction="{{ band_direction }}"
        data-boost="{{ section.settings.scroll_boost }}"
        {% if band == 2 %}aria-hidden="true"{% endif %}
      >
        {%- if band == 1 -%}
          <p class="visually-hidden">{{ items | join: ' · ' | strip_newlines }}</p>
        {%- endif -%}
        <div class="lfx-band__track" aria-hidden="true">
          {%- for copy in (1..2) -%}
            <div class="lfx-band__group">
              {%- for repeat in (1..4) -%}
                {%- for item in items -%}
                  {%- assign clean_item = item | strip -%}
                  {%- if clean_item != blank -%}
                    <span class="lfx-band__item">{{ clean_item }}</span>
                    <span class="lfx-band__sep">
                      {%- case section.settings.separator -%}
                        {%- when 'image' -%}
                          {%- if section.settings.separator_image != blank -%}
                            {{ section.settings.separator_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100, 200', sizes: '60px' }}
                          {%- else -%}
                            {{ lfx_star }}
                          {%- endif -%}
                        {%- when 'burst' -%}
                          {{ lfx_burst }}
                        {%- else -%}
                          {{ lfx_star }}
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .lfx-marquee--{{ section.id }} {
    --lfx-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --band-size: {{ section.settings.text_size }}px;
    --band-size-mobile: {{ section.settings.text_size_mobile }}px;
    background: {{ section.settings.background_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    padding-block: {{ section.settings.padding | times: 0.6 | round }}px;
  }
  .lfx-marquee--{{ section.id }} .lfx-marquee__stack {
    display: grid;
    align-items: center;
  }
  .lfx-marquee--{{ section.id }} .lfx-band {
    grid-area: 1 / 1;
  }
  .lfx-marquee--{{ section.id }} .lfx-band--one {
    z-index: 2;
    --band-bg: {{ section.settings.band_color }};
    --band-fg: {{ section.settings.band_text_color }};
    --band-border: {{ section.settings.band_border_color }};
    --band-sep: {{ section.settings.separator_color }};
    --band-tilt: {{ section.settings.tilt }}deg;
    {% if section.settings.direction == 'right' %}--band-css-direction: reverse;{% endif %}
  }
  .lfx-marquee--{{ section.id }} .lfx-band--two {
    z-index: 1;
    --band-bg: {{ section.settings.band_color_2 }};
    --band-fg: {{ section.settings.band_text_color_2 }};
    --band-border: {{ section.settings.band_border_color_2 }};
    --band-sep: {{ section.settings.separator_color_2 }};
    --band-tilt: {{ section.settings.tilt_2 }}deg;
    {% unless section.settings.direction == 'right' %}--band-css-direction: reverse;{% endunless %}
  }
  .lfx-marquee--{{ section.id }}.has-second { padding-block: {{ section.settings.padding | plus: 20 }}px; }
  /* Phones: the bands are too narrow to read as a cross, so they stack into a chevron */
  @media (max-width: 749px) {
    .lfx-marquee--{{ section.id }} .lfx-band--two { grid-area: 2 / 1; margin-top: -4px; }
    .lfx-marquee--{{ section.id }}.has-second { padding-block: {{ section.settings.padding | times: 0.6 | round }}px {{ section.settings.padding }}px; }
  }
  @media (min-width: 750px) {
    .lfx-marquee--{{ section.id }} { padding-block: {{ section.settings.padding }}px; }
    .lfx-marquee--{{ section.id }}.has-second { padding-block: {{ section.settings.padding | plus: 40 }}px; }
  }
{% endstyle %}

