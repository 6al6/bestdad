{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}

<section class="legenda-odds legenda-odds--{{ section.id }}">
  <div class="legenda-odds__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="legenda-odds__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="legenda-odds__list" role="list">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign icon = 'photo'
            assign multiplier = section.settings.photo_multiplier
            assign label = section.settings.photo_label
          else
            assign icon = 'video'
            assign multiplier = section.settings.video_multiplier
            assign label = section.settings.video_label
          endif
        -%}
        <li class="legenda-odds__item legenda-odds__item--{{ icon }}">
          <div class="legenda-odds__card">
            <span class="legenda-odds__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                {%- if icon == 'photo' -%}
                  <path d="M3 8a2 2 0 0 1 2-2h2.5l1.5-2h6l1.5 2H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="3.5"/>
                {%- else -%}
                  <rect x="2.5" y="6" width="13" height="12" rx="2"/><path d="M15.5 10.5 21.5 7v10l-6-3.5z"/>
                {%- endif -%}
              </svg>
            </span>
            <span class="legenda-odds__multiplier">{{ multiplier }}</span>
            <span class="legenda-odds__label">{{ label | escape | newline_to_br }}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.note != blank -%}
      <p class="legenda-odds__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .legenda-odds--{{ section.id }} {
    --lo-text: {{ section.settings.text_color }};
    background: {{ section.settings.background_color }};
    color: var(--lo-text);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    text-align: center;
  }
  .legenda-odds__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: 600px;
    margin-inline: auto;
    padding: 44px 18px;
  }
  .legenda-odds__heading {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 32px;
    line-height: 1.05;
    text-transform: none;
    letter-spacing: 0;
  }
  .legenda-odds__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legenda-odds__item {
    isolation: isolate;
    margin: 0 12px 14px 0;
  }
  .legenda-odds__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    box-sizing: border-box;
    height: 100%;
    padding: 20px 10px 22px;
    border: 2px solid var(--lo-text);
    background: {{ section.settings.photo_card_color }};
  }
  .legenda-odds__item--video .legenda-odds__card {
    background: {{ section.settings.video_card_color }};
    color: {{ section.settings.video_text_color }};
  }
  .legenda-odds__card::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border: 2px solid var(--lo-text);
    background: #000;
    transform: translate(10px, 12px);
  }
  .legenda-odds__icon { display: flex; }
  .legenda-odds__multiplier {
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-size: 56px;
    line-height: 1;
  }
  .legenda-odds__label {
    font-size: 15px;
    line-height: 1.3;
  }
  .legenda-odds__note {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }
  @media (min-width: 750px) {
    .legenda-odds__inner { padding-block: 64px; }
    .legenda-odds__heading { font-size: 40px; }
    .legenda-odds__list { gap: 32px; }
    .legenda-odds__multiplier { font-size: 72px; }
    .legenda-odds__label { font-size: 17px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Legenda: Draw chances",
  "tag": "section",
  "class": "landing-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Video šteje petkrat več!" },
    { "type": "header", "content": "Photo" },
    { "type": "text", "id": "photo_multiplier", "label": "Big number", "default": "1×" },
    { "type": "textarea", "id": "photo_label", "label": "Text", "info": "A new line in the box starts a new line on the card.", "default": "Objavljena fotografija =\n1 možnost za žreb" },
    { "type": "header", "content": "Video" },
    { "type": "text", "id": "video_multiplier", "label": "Big number", "default": "5×" },
    { "type": "textarea", "id": "video_label", "label": "Text", "info": "A new line in the box starts a new line on the card.", "default": "Objavljen video =\n5 možnosti za žreb" },
    { "type": "text", "id": "note", "label": "Note under the cards" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fef1d5" },
    { "type": "color", "id": "text_color", "label": "Text and borders", "default": "#2b2d45" },
    { "type": "color", "id": "photo_card_color", "label": "Photo card", "default": "#ffffff" },
    { "type": "color", "id": "video_card_color", "label": "Video card", "default": "#ee614c" },
    { "type": "color", "id": "video_text_color", "label": "Video card text", "default": "#fef1d5" },
    { "type": "header", "content": "Wavy divider" },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top divider color",
      "info": "Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Bottom divider color",
      "info": "Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        { "value": "waves-1-patterned_1200x20", "label": "Waves 1 (small)" },
        { "value": "waves-2-patterned_1200x43", "label": "Waves 2 (medium)" },
        { "value": "waves-3-patterned_1200x84", "label": "Waves 3 (large)" },
        { "value": "zig-zag-2-patterned_1200x37", "label": "Zig-zag" },
        { "value": "circles-2-patterned_1200x35", "label": "Circles" },
        { "value": "spikes-1-patterned_1200x132", "label": "Spikes" }
      ],
      "default": "waves-1-patterned_1200x20"
    },
    { "type": "checkbox", "id": "divider_animate", "label": "Animate divider", "default": true }
  ],
  "presets": [{ "name": "Legenda: Draw chances" }]
}
{% endschema %}
