{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}
{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>
{% render 'landing-fx-defs' %}

<section class="lfx lfx-cut lfx-cut--{{ section.id }} lfx-cut--media-{{ section.settings.image_side }}">
  <div class="lfx-cut__inner">
    <div class="lfx-cut__media">
      <div class="lfx-cut__tilt">
        {% render 'landing-fx-media',
          image: section.settings.image,
          shape: section.settings.image_shape,
          ratio: section.settings.image_ratio,
          position: section.settings.image_position,
          sizes: '(min-width: 990px) 560px, 88vw'
        %}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'sticker' -%}
          {% render 'landing-fx-sticker', block: block %}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="lfx-cut__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="lfx-cut__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lfx-heading lfx-cut__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lfx-cut__body landing-marker">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="lfx-cut__cta">
          {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
          {%- if section.settings.note != blank -%}
            <p class="lfx-cut__note">{{ section.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .lfx-cut--{{ section.id }} {
    --lfx-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --lfx-ink: {{ section.settings.ink_color }};
    --lfx-shadow: {{ section.settings.shadow_color }};
    --lfx-offset: {{ section.settings.shadow_offset }}px;
    --lm-color: {{ section.settings.marker_color | color_modify: 'alpha', 0.5 }};
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.button_border_color }};
    --lb-shadow: {{ section.settings.ink_color }};
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  }
  .lfx-cut--{{ section.id }} .lfx-cut__inner {
    display: grid;
    gap: 44px;
    align-items: center;
    max-width: 1240px;
    margin-inline: auto;
    padding: 56px 18px 64px;
  }
  .lfx-cut--{{ section.id }} .lfx-cut__media {
    position: relative;
    width: min(100%, 520px);
    margin-inline: auto;
  }
  .lfx-cut--{{ section.id }} .lfx-cut__tilt { transform: rotate({{ section.settings.image_tilt }}deg); }
  .lfx-cut--{{ section.id }} .lfx-cut__copy { max-width: 560px; margin-inline: auto; }
  .lfx-cut--{{ section.id }} .lfx-cut__kicker {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 12px 7px;
    border: 2px solid var(--lfx-ink);
    background: {{ section.settings.kicker_bg }};
    color: {{ section.settings.kicker_text }};
    box-shadow: 4px 4px 0 var(--lfx-ink);
    font-family: var(--lfx-head);
    font-size: 15px;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .lfx-cut--{{ section.id }} .lfx-cut__heading { font-size: 34px; line-height: 1.02; margin-bottom: 22px; }
  .lfx-cut--{{ section.id }} .lfx-cut__body { font-size: 17px; line-height: 1.5; }
  .lfx-cut--{{ section.id }} .lfx-cut__body p { margin: 0 0 14px; }
  .lfx-cut--{{ section.id }} .lfx-cut__body p:last-child { margin-bottom: 0; }
  .lfx-cut--{{ section.id }} .lfx-cut__body strong { font-weight: 700; }
  .lfx-cut--{{ section.id }} .lfx-cut__cta { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
  .lfx-cut--{{ section.id }} .lfx-cut__note { margin: 0; font-size: 15px; text-align: center; }

  @media (min-width: 990px) {
    .lfx-cut--{{ section.id }} .lfx-cut__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 88px;
      padding: 96px 40px 104px;
    }
    .lfx-cut--{{ section.id }}.lfx-cut--media-right .lfx-cut__media { order: 2; }
    .lfx-cut--{{ section.id }} .lfx-cut__media { width: 100%; max-width: 560px; }
    .lfx-cut--{{ section.id }} .lfx-cut__copy { margin-inline: 0; }
    .lfx-cut--{{ section.id }} .lfx-cut__heading { font-size: 50px; }
    .lfx-cut--{{ section.id }} .lfx-cut__body { font-size: 18px; }
    .lfx-cut--{{ section.id }} .lfx-cut__cta { max-width: 420px; }
  }
{% endstyle %}

