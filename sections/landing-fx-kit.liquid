{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
  assign cards = section.blocks | where: 'type', 'card'
  assign half = cards.size | plus: 1 | divided_by: 2
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}
{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>
{% render 'landing-fx-defs' %}

<section class="lfx lfx-kit lfx-kit--{{ section.id }}">
  <div class="lfx-kit__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lfx-heading lfx-kit__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="lfx-kit__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="lfx-kit__grid">
      <ul class="lfx-kit__col lfx-kit__col--left" role="list">
        {%- for block in cards limit: half -%}
          <li class="lfx-card" {{ block.shopify_attributes }}>
            <h3 class="lfx-card__title">{% if block.settings.emoji != blank %}<span aria-hidden="true">{{ block.settings.emoji }}</span> {% endif %}{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="lfx-card__text">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="lfx-kit__center">
        {%- unless section.settings.ray_shape == 'none' -%}
          <div class="lfx-kit__ray-spin" {% if section.settings.ray_motion %}data-lfx-motion="spin" data-lfx-strength="0.5" data-lfx-dir="1"{% endif %}>
            <div class="lfx-kit__ray lfx-spin-slow" style="clip-path: url(#lfx-clip-{{ section.settings.ray_shape }});"></div>
          </div>
        {%- endunless -%}
        <div class="lfx-kit__photo">
          {% render 'landing-fx-media',
            image: section.settings.image,
            shape: section.settings.image_shape,
            ratio: '1 / 1',
            position: section.settings.image_position,
            sizes: '(min-width: 990px) 420px, 70vw'
          %}
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'sticker' -%}
            {% render 'landing-fx-sticker', block: block %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <ul class="lfx-kit__col lfx-kit__col--right" role="list">
        {%- for block in cards offset: half -%}
          <li class="lfx-card" {{ block.shopify_attributes }}>
            <h3 class="lfx-card__title">{% if block.settings.emoji != blank %}<span aria-hidden="true">{{ block.settings.emoji }}</span> {% endif %}{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="lfx-card__text">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="lfx-kit__cta">
        {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
        {%- if section.settings.note != blank -%}<p class="lfx-kit__note">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .lfx-kit--{{ section.id }} {
    --lfx-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --lfx-ink: {{ section.settings.ink_color }};
    --lfx-shadow: {{ section.settings.ink_color }};
    --lfx-offset: 10px;
    --card-bg: {{ section.settings.card_color }};
    --card-fg: {{ section.settings.card_text_color }};
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.button_border_color }};
    --lb-shadow: {{ section.settings.ink_color }};
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    text-align: center;
  }
  .lfx-kit--{{ section.id }} .lfx-kit__inner { max-width: 1340px; margin-inline: auto; padding: 56px 16px 64px; }
  .lfx-kit--{{ section.id }} .lfx-kit__heading { font-size: 36px; line-height: 1.02; max-width: 820px; margin-inline: auto; }
  .lfx-kit--{{ section.id }} .lfx-kit__intro { max-width: 560px; margin: 14px auto 0; font-size: 17px; line-height: 1.45; }
  .lfx-kit--{{ section.id }} .lfx-kit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    margin-top: 28px;
  }
  .lfx-kit--{{ section.id }} .lfx-kit__col { display: contents; margin: 0; padding: 0; list-style: none; }
  .lfx-kit--{{ section.id }} .lfx-card { margin: 0 8px 8px 0; padding: 14px 12px 16px; }
  .lfx-kit--{{ section.id }} .lfx-card__title { font-size: 17px; }
  .lfx-kit--{{ section.id }} .lfx-card__text { font-size: 14px; }
  .lfx-kit--{{ section.id }} .lfx-kit__center {
    position: relative;
    grid-column: 1 / -1;
    order: -1;
    width: min(76vw, 340px);
    aspect-ratio: 1;
    margin: 34px auto 44px;
  }
  /* The burst sticks out past the photo; on phones it is kept inside the screen so no spike gets cut off */
  .lfx-kit--{{ section.id }} .lfx-kit__ray-spin {
    position: absolute;
    inset: -12%;
    transform: rotate(var(--fx-r, 0deg));
  }
  .lfx-kit--{{ section.id }} .lfx-kit__ray {
    position: absolute;
    inset: 0;
    background: {{ section.settings.ray_color }};
    animation: lfx-spin 60s linear infinite;
  }
  .lfx-kit--{{ section.id }} .lfx-kit__photo { position: absolute; inset: 12%; }
  .lfx-kit--{{ section.id }} .lfx-kit__photo .lfx-media { height: 100%; }
  .lfx-kit--{{ section.id }} .lfx-kit__cta { display: flex; flex-direction: column; gap: 12px; max-width: 420px; margin: 44px auto 0; }
  .lfx-kit--{{ section.id }} .lfx-kit__note { margin: 0; font-size: 15px; }

  @media (min-width: 990px) {
    .lfx-kit--{{ section.id }} .lfx-kit__inner { padding: 96px 40px 104px; }
    .lfx-kit--{{ section.id }} .lfx-kit__heading { font-size: 54px; }
    .lfx-kit--{{ section.id }} .lfx-kit__intro { font-size: 19px; }
    .lfx-kit--{{ section.id }} .lfx-kit__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: 32px;
      margin-top: 40px;
    }
    .lfx-kit--{{ section.id }} .lfx-kit__col { display: grid; gap: 30px; }
    .lfx-kit--{{ section.id }} .lfx-card { margin: 0; padding: 22px 24px 24px; }
    .lfx-kit--{{ section.id }} .lfx-card__title { font-size: 23px; }
    .lfx-kit--{{ section.id }} .lfx-card__text { font-size: 16px; }
    .lfx-kit--{{ section.id }} .lfx-kit__col--left .lfx-card:nth-child(2) { transform: translateX(-18px) rotate(-1.5deg); }
    .lfx-kit--{{ section.id }} .lfx-kit__col--right .lfx-card:nth-child(2) { transform: translateX(18px) rotate(1.5deg); }
    .lfx-kit--{{ section.id }} .lfx-kit__center { order: 0; grid-column: auto; width: 100%; max-width: 480px; margin: 0 auto; }
    .lfx-kit--{{ section.id }} .lfx-kit__ray-spin { inset: -16%; }
  }
{% endstyle %}

