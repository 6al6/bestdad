{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}

<section class="landing-reasons landing-reasons--{{ section.id }}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="landing-reasons__inner">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="landing-reasons__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-reasons__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="landing-reasons__intro-text landing-marker">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="landing-reasons__list" role="list">
        {%- for block in section.blocks -%}
          <li class="landing-reasons__item" {{ block.shopify_attributes }}>
            <div
              class="landing-reasons__card"
              style="--lrn-card: {{ block.settings.card_color }}; --lrn-card-text: {{ block.settings.text_color }}; --lrn-card-border: {{ block.settings.border_color }};"
            >
              {%- if block.settings.image != blank -%}
                {{-
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: class: 'landing-reasons__image', loading: 'lazy', widths: '354, 600, 900', sizes: '(min-width: 990px) 33vw, calc(100vw - 36px)', alt: block.settings.image.alt | default: ''
                -}}
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="landing-reasons__title">{{ block.settings.title | newline_to_br }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="landing-reasons__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="landing-reasons__card-cta">
                  {% render 'landing-button', label: block.settings.button_label, link: block.settings.button_link %}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="landing-cta">
        {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .landing-reasons__image { display: block; width: 100%; height: auto; margin-bottom: 14px; border-radius: 8px; }
  .landing-reasons__card-cta { margin-top: 18px; }
  .landing-reasons--{{ section.id }} {
    --lrn-shadow: {{ section.settings.shadow_color }};
    --lrn-shadow-border: {{ section.settings.shadow_border_color }};
    --lm-color: color-mix(in srgb, {{ section.settings.highlight_color }} {{ section.settings.highlight_opacity }}%, transparent);
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    text-align: center;
  }
  .landing-reasons__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 600px;
    margin-inline: auto;
    padding: 60px 18px 32px;
  }
  .landing-reasons__intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .landing-reasons__heading {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 36px;
    line-height: 1.05;
    text-transform: none;
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .landing-reasons__intro-text {
    font-size: 17px;
    line-height: 1.5;
  }
  .landing-reasons__intro-text p { margin: 0 0 1.5em; }
  .landing-reasons__intro-text p:last-child { margin-bottom: 0; }
  .landing-reasons__intro-text strong { font-weight: 700; }

  .landing-reasons__list {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Room for the offset black box */
  .landing-reasons__item {
    isolation: isolate;
    margin: 0 15px 16px 0;
  }
  .landing-reasons__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
    height: 100%;
    padding: 30px 24px;
    border: 2px solid var(--lrn-card-border);
    background: var(--lrn-card);
    color: var(--lrn-card-text);
  }
  /* Offset black box behind */
  .landing-reasons__card::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border: 2px solid var(--lrn-shadow-border);
    background: var(--lrn-shadow);
    transform: translate(15px, 16px);
  }
  .landing-reasons__title {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 27px;
    line-height: 1.05;
    color: inherit;
    text-transform: none;
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .landing-reasons__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  @media (min-width: 990px) {
    .landing-reasons__inner { max-width: 1200px; padding: 64px 24px; gap: 48px; }
    .landing-reasons__intro { max-width: 800px; margin-inline: auto; }
    .landing-reasons__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; row-gap: 32px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Landing: Reason cards",
  "tag": "section",
  "class": "landing-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a menu link jump here, e.g. /#kako-deluje"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Za podvige, spomine in malo fotrovske slave."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text under the heading",
      "info": "Use Underline to highlight a phrase with the marker color. Each paragraph gets an empty line after it.",
      "default": "<p>Otrok ne potrebuje še ene igrače. Fotr pa ne knjige, ki mu razlaga, kaj vse dela narobe. Komični priročnik fotra najprej nasmeji, potem pa mu ponudi 28 pripravljenih izgovorov, da skupaj z otrokom naredita kaj pametnega, koristnega ali vsaj primerno neumnega.</p><p><u>Zakaj izbrati ta komplet:</u></p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fef1d5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading and text",
      "default": "#2b2d45"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Marker highlight",
      "default": "#ee614c"
    },
    {
      "type": "range",
      "id": "highlight_opacity",
      "label": "Marker opacity (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Box behind the cards",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "shadow_border_color",
      "label": "Box behind the cards border",
      "default": "#fef1d5"
    },
    {
      "type": "header",
      "content": "Wavy divider"
    },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top divider color",
      "info": "Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Bottom divider color",
      "info": "Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        {
          "value": "waves-1-patterned_1200x20",
          "label": "Waves 1 (small)"
        },
        {
          "value": "waves-2-patterned_1200x43",
          "label": "Waves 2 (medium)"
        },
        {
          "value": "waves-3-patterned_1200x84",
          "label": "Waves 3 (large)"
        },
        {
          "value": "zig-zag-2-patterned_1200x37",
          "label": "Zig-zag"
        },
        {
          "value": "circles-2-patterned_1200x35",
          "label": "Circles"
        },
        {
          "value": "spikes-1-patterned_1200x132",
          "label": "Spikes"
        }
      ],
      "default": "waves-1-patterned_1200x20"
    },
    {
      "type": "checkbox",
      "id": "divider_animate",
      "label": "Animate divider",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "info": "A new line in the box starts a new line on the page.",
          "default": "Card title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Card text"
        },
        {
          "type": "color",
          "id": "card_color",
          "label": "Card background",
          "default": "#ee614c"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card text",
          "default": "#fef1d5"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Card border",
          "default": "#fef1d5"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing: Reason cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "28 odgovorov\nna vprašanje:\n»Kaj bova danes počela?«",
            "text": "Fotr ne rabi biti kreativec, animator ali mojster Pinteresta, da z otrokom izpelje nekaj, kar si bo za vedno zapomnil. Odpre komični priročnik, izbere misijo in gresta v akcijo. Brez googlanja, ChatGPT-ja in šestnajstih odprtih zavihkov.",
            "card_color": "#ee614c",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Bleščeča trofeja za vsak podvig.",
            "text": "Fotr in otrok se lahko igrata vsak dan, uspešno igro pa le redko proslavita! Z bleščečo nalepko označita opravljeno misijo in na plakatu zbirata skupne dosežke. Otrok vidi opravljene podvige in prostor za nove. Ati ima končno dokaze za svojo veličino.",
            "card_color": "#f72828",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Smešno že pred prvo misijo.",
            "text": "Lado Bizovičar in Niko Zagode sta se pri humorju spustila s ketne. Priročnik se pošteno pozabava na račun fotrov in njihovih vzgojnih teorij. Fotr se nareži, vsaj dokler misli, da so štosi o drugih fotrih.",
            "card_color": "#2b2d45",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Darilo, ki ne konča v predalu.",
            "text": "Kravata čaka na naslednjo poroko, ta komplet pa gre v akcijo že prvi vikend. Darilo je za fotra. Uporabljata ga oba z otrokom. Mami pa dobi malo miru.",
            "card_color": "#ffffff",
            "text_color": "#2b2d45",
            "border_color": "#2b2d45"
          }
        }
      ]
    }
  ]
}
{% endschema %}
