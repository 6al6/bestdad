{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
  assign lines = section.settings.heading | newline_to_br | split: '<br />'
  assign accent_line = section.settings.accent_line
  # Phones: cap the headline rows so price and button fit in the first screen
  assign max_mobile = section.settings.max_size_mobile
  if section.settings.fold_first and section.settings.fold_title_max < max_mobile
    assign max_mobile = section.settings.fold_title_max
  endif
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}
{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>
{% render 'landing-fx-defs' %}

<section class="lfx lfx-hero lfx-hero--{{ section.id }}">
  <div class="lfx-hero__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'sticker' -%}
        {% render 'landing-fx-sticker', block: block %}
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.show_stars or section.settings.quote != blank -%}
      <div class="lfx-hero__proof">
        {%- if section.settings.show_stars -%}
          <div class="lfx-hero__stars">{% render 'landing-stars' %}</div>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <p class="lfx-hero__quote">
            {{- section.settings.quote -}}
            {%- if section.settings.quote_author != blank %} <span>{{ section.settings.quote_author }}</span>{% endif -%}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <h1
      class="lfx-hero__title"
      data-lfx-fit
      data-max="{{ section.settings.max_size }}"
      data-max-mobile="{{ max_mobile }}"
    >
      {%- if section.settings.kicker != blank -%}
        <span class="lfx-hero__kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- for line in lines -%}
        {%- assign clean_line = line | strip -%}
        {%- if clean_line != blank -%}
          <span class="lfx-hero__row"><span class="lfx-hero__line{% if forloop.index == accent_line %} is-accent{% endif %}" data-lfx-line>{{ clean_line }}</span></span>
        {%- endif -%}
      {%- endfor -%}
    </h1>

    <div class="lfx-hero__stage">
      {% render 'landing-fx-media',
        image: section.settings.image,
        shape: section.settings.image_shape,
        ratio: section.settings.image_ratio,
        position: section.settings.image_position,
        loading: 'eager',
        sizes: '(min-width: 1100px) 900px, 88vw'
      %}
    </div>

    <div class="lfx-hero__copy">
      {%- if section.settings.text != blank -%}
        <p class="lfx-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- liquid
        assign price_product = section.settings.product
        if price_product == blank and section.settings.product_handle != blank
          assign price_product = all_products[section.settings.product_handle]
        endif
      -%}
      {%- if section.settings.show_price and price_product != blank -%}
        {%- assign variant = price_product.selected_or_first_available_variant -%}
        <p class="lfx-hero__price">
          <span class="lfx-hero__now">{{ variant.price | money }}</span>
          {%- if section.settings.show_compare and variant.compare_at_price > variant.price -%}
            {%- assign saved = variant.compare_at_price | minus: variant.price | money -%}
            <s class="lfx-hero__was">{{ variant.compare_at_price | money }}</s>
            {%- if section.settings.save_label != blank -%}
              <span class="lfx-hero__save">{{ section.settings.save_label | replace: '[amount]', saved }}</span>
            {%- endif -%}
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="lfx-hero__cta">
          {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
        </div>
      {%- endif -%}
      {%- if section.settings.trust_line != blank -%}
        <ul class="lfx-hero__trust">
          {%- assign trust_items = section.settings.trust_line | split: '·' -%}
          {%- for item in trust_items -%}
            {%- assign clean_item = item | strip -%}
            {%- if clean_item != blank -%}
              <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ clean_item }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="lfx-hero__note">
          {%- if section.settings.note_link != blank -%}
            <a href="{{ section.settings.note_link }}">{{ section.settings.note }}</a>
          {%- else -%}
            {{ section.settings.note }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .lfx-hero--{{ section.id }} {
    --lfx-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --lfx-ink: {{ section.settings.ink_color }};
    --lfx-shadow: {{ section.settings.ink_color }};
    --lfx-offset: 14px;
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.button_border_color }};
    --lb-shadow: {{ section.settings.ink_color }};
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  }
  .lfx-hero--{{ section.id }} .lfx-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1320px;
    margin-inline: auto;
    padding: 28px 16px 48px;
    text-align: center;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 14px;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__stars { color: {{ section.settings.star_color }}; }
  .lfx-hero--{{ section.id }} .lfx-hero__quote { margin: 0; font-size: 15px; line-height: 1.25; }
  .lfx-hero--{{ section.id }} .lfx-hero__quote span { white-space: nowrap; }
  .lfx-hero--{{ section.id }} .lfx-hero__title {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    font-family: var(--lfx-head);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }
  .lfx-hero--{{ section.id }} .lfx-hero__kicker {
    display: block;
    margin-bottom: 0.35em;
    font-size: clamp(18px, 2.6vw, 34px);
    line-height: 1;
    letter-spacing: 0;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__row { display: block; }
  .lfx-hero--{{ section.id }} .lfx-hero__line {
    display: inline-block;
    white-space: nowrap;
    font-size: clamp(48px, 13vw, {{ section.settings.max_size }}px);
  }
  .lfx-hero--{{ section.id }} .lfx-hero__line.is-accent { color: {{ section.settings.accent_color }}; }
  .lfx-hero--{{ section.id }} .lfx-hero__stage {
    position: relative;
    z-index: 2;
    width: min(100%, {{ section.settings.image_width }}px);
    margin-top: calc(var(--lfx-last-size, 110px) * 0.72 * {{ section.settings.overlap | divided_by: -100.0 }});
    transform: rotate({{ section.settings.image_tilt }}deg);
  }
  .lfx-hero--{{ section.id }} .lfx-hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 640px;
    margin-top: 40px;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__text { margin: 0; font-size: 18px; line-height: 1.45; }
  .lfx-hero--{{ section.id }} .lfx-hero__text strong { font-weight: 700; }
  .lfx-hero--{{ section.id }} .lfx-hero__cta { width: 100%; max-width: 440px; }
  .lfx-hero--{{ section.id }} .lfx-hero__note { margin: 0; font-size: 15px; line-height: 1.4; opacity: 0.85; }
  .lfx-hero--{{ section.id }} .lfx-hero__note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .lfx-hero--{{ section.id }} .lfx-hero__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 12px;
    margin: 0 0 -4px;
    line-height: 1;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__now {
    font-family: var(--lfx-head);
    font-size: 34px;
    color: {{ section.settings.text_color }};
  }
  .lfx-hero--{{ section.id }} .lfx-hero__was { font-size: 19px; opacity: 0.6; }
  .lfx-hero--{{ section.id }} .lfx-hero__save {
    padding: 6px 10px 5px;
    border: 2px solid var(--lfx-ink);
    background: {{ section.settings.save_bg_color }};
    color: {{ section.settings.save_text_color }};
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 var(--lfx-ink);
  }
  .lfx-hero--{{ section.id }} .lfx-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 16px;
    margin: -4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .lfx-hero--{{ section.id }} .lfx-hero__trust li { display: inline-flex; align-items: center; gap: 5px; }
  .lfx-hero--{{ section.id }} .lfx-hero__trust svg { width: 15px; height: 15px; flex: none; color: {{ section.settings.accent_color }}; }

  @media (max-width: 749px) {
    {%- if section.settings.mobile_compact -%}
    .lfx-hero--{{ section.id }} .lfx-hero__inner { padding-top: 16px; }
    .lfx-hero--{{ section.id }} .lfx-hero__proof { margin-bottom: 8px; }
    .lfx-hero--{{ section.id }} .lfx-hero__copy { margin-top: 18px; gap: 12px; }
    .lfx-hero--{{ section.id }} .lfx-hero__text { font-size: 16px; line-height: 1.4; }
    /* Phones: price and button come straight after the image, the description follows */
    .lfx-hero--{{ section.id }} .lfx-hero__price { order: 1; flex-wrap: nowrap; gap: 10px; }
    .lfx-hero--{{ section.id }} .lfx-hero__cta { order: 2; }
    .lfx-hero--{{ section.id }} .lfx-hero__trust { order: 3; }
    .lfx-hero--{{ section.id }} .lfx-hero__text { order: 4; }
    .lfx-hero--{{ section.id }} .lfx-hero__note { order: 5; }
    .lfx-hero--{{ section.id }} .lfx-hero__now { font-size: 30px; }
    .lfx-hero--{{ section.id }} .lfx-hero__was { font-size: 17px; }
    .lfx-hero--{{ section.id }} .lfx-hero__save { padding: 5px 8px 4px; font-size: 12px; }
    {%- endif -%}
  }

  {%- if section.settings.overlap_mobile_custom %}
  @media (max-width: 749px) {
    .lfx-hero--{{ section.id }} .lfx-hero__stage {
      margin-top: calc(var(--lfx-last-size, 110px) * 0.72 * {{ section.settings.overlap_mobile | divided_by: -100.0 }});
    }
  }
  {%- endif %}

  {%- if section.settings.fold_first %}
  /* Phones: headline, image, price and button all fit in the first screen (about 600px) */
  @media (max-width: 749px) {
    .lfx-hero--{{ section.id }} .lfx-hero__inner { padding-top: 12px; }
    .lfx-hero--{{ section.id }} .lfx-hero__proof { margin-bottom: 6px; }
    .lfx-hero--{{ section.id }} .lfx-media { --ratio: {{ section.settings.fold_image_ratio }} !important; }
    {%- if section.settings.fold_hide_header %}
    .shopify-section:has(> .landing-header):has(+ .shopify-section .lfx-hero--{{ section.id }}) { display: none; }
    {%- endif %}
  }
  {%- endif %}

  @media (min-width: 750px) {
    .lfx-hero--{{ section.id }} .lfx-hero__inner { padding: 40px 32px 72px; }
    .lfx-hero--{{ section.id }} .lfx-hero__copy { margin-top: 56px; }
    .lfx-hero--{{ section.id }} .lfx-hero__text { font-size: 20px; }
  }
{% endstyle %}

