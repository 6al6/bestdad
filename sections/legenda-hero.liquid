{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}

<section class="legenda-hero legenda-hero--{{ section.id }}">
  <div class="legenda-hero__inner">
    <h1 class="legenda-hero__heading">
      {{- section.settings.heading }}
      {%- if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{% endif -%}
    </h1>

    {%- if section.settings.image != blank -%}
      <div class="legenda-hero__media">
        {{-
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'legenda-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 800, 1000, 1400',
            sizes: '(min-width: 750px) 640px, calc(100vw - 36px)',
            alt: section.settings.image.alt
        -}}
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="legenda-hero__text landing-marker">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="legenda-hero__cta">
        {%- if section.settings.cta_lead != blank -%}
          <p class="legenda-hero__lead">{{ section.settings.cta_lead }}</p>
        {%- endif -%}
        {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
      </div>
    {%- endif -%}

    {%- if section.settings.publish_text != blank -%}
      <div class="legenda-hero__publish">
        <p class="legenda-hero__publish-text">{{ section.settings.publish_text }}</p>
        {%- if section.settings.show_social -%}
          {%- liquid
            assign links = ''
            if settings.social_instagram_link != blank
              assign links = links | append: 'instagram|' | append: settings.social_instagram_link | append: '^'
            endif
            if settings.social_facebook_link != blank
              assign links = links | append: 'facebook|' | append: settings.social_facebook_link | append: '^'
            endif
            if settings.social_tiktok_link != blank
              assign links = links | append: 'tiktok|' | append: settings.social_tiktok_link | append: '^'
            endif
            assign links = links | append: 'web|' | append: shop.url
            assign links = links | split: '^'
          -%}
          <ul class="legenda-hero__social" role="list">
            {%- for link in links -%}
              {%- assign parts = link | split: '|' -%}
              <li>
                <a href="{{ parts[1] }}" target="_blank" rel="noopener" aria-label="{{ parts[0] | capitalize }}">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    {%- case parts[0] -%}
                      {%- when 'instagram' -%}
                        <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
                      {%- when 'facebook' -%}
                        <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"/>
                      {%- when 'tiktok' -%}
                        <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.3 4.5 5 4.8"/>
                      {%- else -%}
                        <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/>
                    {%- endcase -%}
                  </svg>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .legenda-hero--{{ section.id }} {
    --lh-text: {{ section.settings.text_color }};
    --lm-color: color-mix(in srgb, {{ section.settings.accent_color }} 50%, transparent);
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.button_border_color }};
    --lb-shadow: {{ section.settings.text_color }};
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: var(--lh-text);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    text-align: center;
  }
  .legenda-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 720px;
    margin-inline: auto;
    padding: 40px 18px 44px;
  }
  .legenda-hero__heading {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
    text-transform: none;
    letter-spacing: 0;
    color: var(--lh-text);
  }
  .legenda-hero__heading span { color: {{ section.settings.accent_color }}; }
  .legenda-hero__media {
    position: relative;
    isolation: isolate;
    width: calc(100% - 14px);
    margin: 0 14px 16px 0;
  }
  /* Offset block behind the photo, same as the landing cards */
  .legenda-hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 2px solid var(--lh-text);
    background: {{ section.settings.accent_color }};
    transform: translate(14px, 16px);
  }
  .legenda-hero__image {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    border: 2px solid var(--lh-text);
    background: #d9d9d9;
  }
  .legenda-hero__text {
    max-width: 520px;
    font-size: 17px;
    line-height: 1.45;
  }
  .legenda-hero__text p { margin: 0 0 1em; }
  .legenda-hero__text p:last-child { margin-bottom: 0; }
  .legenda-hero__text strong { font-weight: 700; }
  .legenda-hero__cta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 420px;
  }
  .legenda-hero__lead {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-size: 22px;
    line-height: 1.15;
  }
  .legenda-hero__publish {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 460px;
  }
  .legenda-hero__publish-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }
  .legenda-hero__social {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legenda-hero__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--lh-text);
    border-radius: 50%;
    color: var(--lh-text);
  }
  .legenda-hero__social a:hover,
  .legenda-hero__social a:focus-visible {
    background: var(--lh-text);
    color: {{ section.settings.background_color }};
  }
  @media (min-width: 990px) {
    .legenda-hero__inner { padding: 64px 18px; gap: 32px; }
    .legenda-hero__heading { font-size: 56px; }
    .legenda-hero__text { font-size: 19px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Legenda: Hero",
  "tag": "section",
  "class": "landing-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ujemi vajin trenutek." },
    { "type": "text", "id": "heading_accent", "label": "Heading (highlighted part)", "default": "In nagrado!" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image under the heading",
      "info": "Main prize visual or a photo of a dad and child."
    },
    { "type": "header", "content": "Text" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "info": "Keep it short. Underline renders as a marker highlight.",
      "default": "<p><strong>Ni vama treba izvajati misije pred kamero!</strong></p><p>Ujemi trenutek, ko se z otrokom smejita, zabavata, objameta, data petko ali počneta kakšno vrhunsko fotrovsko neumnost. <u>Bolj kot popoln posnetek nas zanima resničen trenutek.</u></p>"
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_lead", "label": "Text above button", "default": "Pošlji nam fotko ali kratek video vajinega momenta." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Pošlji fotko ali video" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "#oddaja scrolls to the form." },
    { "type": "header", "content": "Publishing" },
    {
      "type": "textarea",
      "id": "publish_text",
      "label": "Publishing text",
      "default": "Izmed prejetih prispevkov bomo izbrali tiste, ki jih objavimo na naših družbenih omrežjih in spletni strani."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social and website icons",
      "info": "Links come from Theme settings > Social media.",
      "default": true
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fef1d5" },
    { "type": "color", "id": "text_color", "label": "Text and borders", "default": "#2b2d45" },
    { "type": "color", "id": "accent_color", "label": "Heading highlight, marker and photo offset", "default": "#ee614c" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#f72828" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "button_border_color", "label": "Button inner border", "default": "#fef1d5" },
    { "type": "header", "content": "Wavy divider" },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top divider color",
      "info": "Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Bottom divider color",
      "info": "Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        { "value": "waves-1-patterned_1200x20", "label": "Waves 1 (small)" },
        { "value": "waves-2-patterned_1200x43", "label": "Waves 2 (medium)" },
        { "value": "waves-3-patterned_1200x84", "label": "Waves 3 (large)" },
        { "value": "zig-zag-2-patterned_1200x37", "label": "Zig-zag" },
        { "value": "circles-2-patterned_1200x35", "label": "Circles" },
        { "value": "spikes-1-patterned_1200x132", "label": "Spikes" }
      ],
      "default": "waves-1-patterned_1200x20"
    },
    { "type": "checkbox", "id": "divider_animate", "label": "Animate divider", "default": true }
  ],
  "presets": [{ "name": "Legenda: Hero" }]
}
{% endschema %}
