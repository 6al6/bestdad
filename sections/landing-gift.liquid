{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
  assign button_link = section.settings.button_link | default: '#product'
  assign show_note = false
  if section.settings.note_avatar != blank or section.settings.note_title != blank or section.settings.note_text != blank or section.settings.note_author != blank
    assign show_note = true
  endif
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}

<section class="landing-gift landing-gift--{{ section.id }}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="landing-gift__inner">
    {%- if section.settings.show_card -%}
      <div class="landing-gift__card-wrap">
        <div class="landing-gift__card">
          {%- if section.settings.image != blank -%}
            {{-
              section.settings.image
              | image_url: width: 1100
              | image_tag:
                class: 'landing-gift__image',
                loading: 'lazy',
                widths: '334, 540, 668, 1100',
                sizes: '(min-width: 990px) 540px, calc(100vw - 60px)',
                alt: section.settings.image.alt | default: section.settings.title
            -}}
          {%- endif -%}

          <div class="landing-gift__copy">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="landing-gift__head">
                {%- if section.settings.title != blank -%}
                  <h2 class="landing-gift__title">{{ section.settings.title }}</h2>
                {%- endif -%}
                {%- if section.settings.subtitle != blank -%}
                  <p class="landing-gift__subtitle">{{ section.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="landing-gift__text">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>

          {%- if section.settings.button_label != blank or section.settings.button_note != blank -%}
            <div class="landing-gift__cta">
              {% render 'landing-button', label: section.settings.button_label, link: button_link %}
              {%- if section.settings.button_note != blank -%}
                <p class="landing-gift__button-note">{{ section.settings.button_note }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if show_note -%}
      <div class="landing-gift__note">
        {%- if section.settings.note_avatar != blank -%}
          {{-
            section.settings.note_avatar
            | image_url: width: 320
            | image_tag: class: 'landing-gift__avatar', width: 80, height: 72, loading: 'lazy', widths: '160, 240, 320', sizes: '80px', alt: section.settings.note_avatar.alt | default: section.settings.note_author
          -}}
        {%- endif -%}
        <div class="landing-gift__note-body">
          {%- if section.settings.note_title != blank -%}
            <h3 class="landing-gift__note-title">{{ section.settings.note_title }}</h3>
          {%- endif -%}
          {%- if section.settings.note_text != blank -%}
            <div class="landing-gift__note-text">{{ section.settings.note_text }}</div>
          {%- endif -%}
          {%- if section.settings.note_author != blank or section.settings.note_role != blank -%}
            <div class="landing-gift__author">
              {%- if section.settings.note_author != blank -%}
                <p class="landing-gift__name">{{ section.settings.note_author }}</p>
              {%- endif -%}
              {%- if section.settings.note_role != blank -%}
                <p class="landing-gift__role">{{ section.settings.note_role }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'landing-divider' %}

{% style %}
  .landing-gift--{{ section.id }} {
    --lg-card: {{ section.settings.card_color }};
    --lg-card-text: {{ section.settings.card_text_color }};
    --lg-card-border: {{ section.settings.card_border_color }};
    --lg-shadow: {{ section.settings.shadow_color }};
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.card_border_color }};
    --lb-shadow: {{ section.settings.button_shadow_color }};
    --lb-shadow-width: 4px;
    --lb-border-width: 2px;
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    text-align: center;
  }
  .landing-gift__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 600px;
    margin-inline: auto;
    padding: 60px 8px;
  }

  /* Card with an offset black box behind; the wrapper leaves room for the offset */
  .landing-gift__card-wrap { isolation: isolate; margin: 0 18px 19px 0; }
  .landing-gift__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 12px 12px 30px;
    border: 2px solid var(--lg-card-border);
    background: var(--lg-card);
    color: var(--lg-card-text);
  }
  .landing-gift__card::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border: 2px solid var(--lg-card-border);
    background: var(--lg-shadow);
    transform: translate(18px, 19px);
  }
  .landing-gift__image {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border: 1.5px solid var(--lg-card-border);
    border-radius: 6px;
    object-fit: cover;
  }
  .landing-gift__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0 8px;
  }
  .landing-gift__head { display: flex; flex-direction: column; gap: 20px; }
  .landing-gift__title {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 32px;
    line-height: 1.05;
    color: inherit;
    text-transform: none;
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .landing-gift__subtitle { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.5; }
  .landing-gift__text { font-size: 17px; line-height: 1.5; }
  .landing-gift__text p { margin: 0 0 1.5em; }
  .landing-gift__text p:last-child { margin-bottom: 0; }
  .landing-gift__text strong { font-weight: 700; }
  .landing-gift__cta { display: flex; flex-direction: column; gap: 8px; }
  .landing-gift__button-note { margin: 0; font-size: 16px; line-height: 1.5; }

  /* Note under the card (same look as "Landing: Avatar quote") */
  .landing-gift__note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 0 8px;
  }
  .landing-gift__avatar {
    display: block;
    box-sizing: border-box;
    width: 80px;
    height: 72px;
    border: 1.2px solid {{ section.settings.avatar_border_color }};
    border-radius: 4px;
    object-fit: cover;
  }
  .landing-gift__note-body { display: flex; flex-direction: column; gap: 20px; width: 100%; }
  .landing-gift__note-title {
    margin: 0;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: 400;
    font-size: 20px;
    line-height: 1.05;
    color: inherit;
    text-transform: none;
    letter-spacing: 0;
  }
  .landing-gift__note-text { font-size: 17px; line-height: 1.5; }
  .landing-gift__note-text p { margin: 0 0 1.5em; }
  .landing-gift__note-text p:last-child { margin-bottom: 0; }
  .landing-gift__note-text strong { font-weight: 700; }
  .landing-gift__author { display: flex; flex-direction: column; gap: 2px; line-height: 1.2; }
  .landing-gift__name,
  .landing-gift__role { margin: 0; }
  .landing-gift__name { font-size: 18px; font-weight: 700; }
  .landing-gift__role { font-size: 16px; font-style: italic; color: {{ section.settings.role_color }}; }

  @media (min-width: 990px) {
    .landing-gift__inner { padding: 64px 24px; gap: 64px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Landing: Gift card",
  "tag": "section",
  "class": "landing-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a menu link jump here, e.g. /#kako-deluje"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "checkbox",
      "id": "show_card",
      "label": "Show card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Square, at least 1100 x 1100 px."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Boljše darilo kot nogavice."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Bold line under the title",
      "default": "Za frenda, sina, zeta ali moža."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Use Bold and Italic for emphasis.",
      "default": "<p>To ni knjiga za na polico. Je 28 načrtov za skupne dogodivščine, pri katerih se zabavata oba. Fotr dobi ideje in jasna navodila, otrok pa priložnost za zgodbe, ki se začnejo z: <strong>»<em>A veš, kaj sva s fotrom …</em>«</strong></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Podari komplet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to scroll to the product section (anchor #product)."
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Note under button",
      "default": "P. S.: Nogavice so še vedno možnost. Ne bomo sodili. Naglas."
    },
    {
      "type": "header",
      "content": "Note under the card"
    },
    {
      "type": "paragraph",
      "content": "Leave every field here empty to hide the note."
    },
    {
      "type": "image_picker",
      "id": "note_avatar",
      "label": "Author photo",
      "info": "About 80 x 72."
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Title",
      "default": "Drage mame!"
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Text",
      "info": "Each paragraph gets an empty line after it.",
      "default": "<p>To knjigo kupite svojim partnerjem zato, ker nujno potrebujete nekaj časa samo zase. Otroke boste sicer dobile nazaj umazane in utrujene, a srečne in zadovoljne.</p><p>Včasih se lahko pridružite njihovim pustolovščinam, da ne boste samo hišni policaj. Je pa res, da niso vsi očetje po naravi tako otročji in trapasti kot je Lado, zagotovo pa imajo svoje potomce tako neskončno radi kot on.</p><p>In ljubezen iz vseh nas lahko naredi čarovnike, pirate, in najboljše fotre na svetu.</p>"
    },
    {
      "type": "text",
      "id": "note_author",
      "label": "Name",
      "default": "Desa Muck"
    },
    {
      "type": "text",
      "id": "note_role",
      "label": "Job",
      "default": "pisateljica, dramatičarka, publicistka, igralka, scenaristka in publicistka"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Note text",
      "default": "#2b2d45"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Job",
      "default": "#2b2d45"
    },
    {
      "type": "color",
      "id": "avatar_border_color",
      "label": "Author photo border",
      "default": "#2b2d45"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ee614c"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#fef1d5"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card, photo and button borders",
      "default": "#fef1d5"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Box behind the card",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#f72828"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_shadow_color",
      "label": "Button shadow",
      "default": "#2b2d45"
    },
    {
      "type": "header",
      "content": "Wavy divider"
    },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top divider color",
      "info": "Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Bottom divider color",
      "info": "Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        {
          "value": "waves-1-patterned_1200x20",
          "label": "Waves 1 (small)"
        },
        {
          "value": "waves-2-patterned_1200x43",
          "label": "Waves 2 (medium)"
        },
        {
          "value": "waves-3-patterned_1200x84",
          "label": "Waves 3 (large)"
        },
        {
          "value": "zig-zag-2-patterned_1200x37",
          "label": "Zig-zag"
        },
        {
          "value": "circles-2-patterned_1200x35",
          "label": "Circles"
        },
        {
          "value": "spikes-1-patterned_1200x132",
          "label": "Spikes"
        }
      ],
      "default": "waves-1-patterned_1200x20"
    },
    {
      "type": "checkbox",
      "id": "divider_animate",
      "label": "Animate divider",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Landing: Gift card"
    }
  ]
}
{% endschema %}
