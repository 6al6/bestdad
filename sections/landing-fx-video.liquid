abel":"Float up and down"},{"value":"travel","label":"Travel sideways"},{"value":"wobble","label":"Wobble (always)"}],"default":"spin"},{"type":"range","id":"strength","label":"Motion strength","min":10,"max":200,"step":10,"unit":"%","default":100},{"type":"checkbox","id":"reverse","label":"Reverse direction","default":false},{"type":"checkbox","id":"slap","label":"Slap on when it scrolls into view","default":true},{"type":"header","content":"Colors"},{"type":"color","id":"bg","label":"Sticker color","default":"#f6b52e"},{"type":"color","id":"fg","label":"Text","default":"#2b2d45"},{"type":"color","id":"outline","label":"Outline and shadow","default":"#2b2d45"},{"type":"checkbox","id":"shadow","label":"Hard shadow","default":true}]}],"presets":[{"name":"Landing FX: Video","blocks":[{"type":"sticker","settings":{"kind":"burst","text":"Watch\nthis","bg":"#f72828","fg":"#fef1d5"}}]}]}
