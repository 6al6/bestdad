{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_main_font
  assign video = section.settings.video
  assign ratio = section.settings.video_ratio
  assign sound_pos = section.settings.sound_position | default: 'below'
  if ratio == 'auto'
    if video != blank and video.aspect_ratio > 0
      assign ratio = video.aspect_ratio
    else
      assign ratio = '4 / 5'
    endif
  endif
-%}

{{ 'landing-shared.css' | asset_url | stylesheet_tag }}
{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>
{% render 'landing-fx-defs' %}

<section
  class="lfx lfx-cut lfx-vid lfx-vid--{{ section.id }} lfx-cut--media-{{ section.settings.video_side }}"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}
>
  <div class="lfx-vid__inner">
    <div class="lfx-vid__media">
      <div class="lfx-vid__tilt">
        <div class="lfx-media lfx-media--frame" style="--ratio: {{ ratio }};">
          <div class="lfx-media__img">
            {%- if video != blank -%}
              <video
                class="lfx-vid__video"
                playsinline
                muted
                {% if section.settings.loop %}loop{% endif %}
                preload="none"
                {% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 1080 }}"{% endif %}
                aria-label="{{ video.alt | default: section.settings.heading | escape }}"
                data-lfx-video
                data-autoplay="{{ section.settings.autoplay }}"
              >
                {%- for source in video.sources -%}
                  {%- if source.format == 'm3u8' -%}
                    <source src="{{ source.url }}" type="application/x-mpegURL">
                  {%- endif -%}
                {%- endfor -%}
                {%- comment -%} Fallback mp4 at the chosen quality {%- endcomment -%}
                {%- liquid
                  assign cap_label = section.settings.max_height | default: '720' | append: 'p'
                  assign best_url = ''
                  assign first_url = ''
                  for source in video.sources
                    if source.mime_type contains 'mp4'
                      if first_url == blank
                        assign first_url = source.url
                      endif
                      if source.url contains cap_label
                        assign best_url = source.url
                      endif
                    endif
                  endfor
                  if best_url == blank
                    assign best_url = first_url
                  endif
                -%}
                {%- if best_url != blank -%}
                  <source src="{{ best_url }}" type="video/mp4">
                {%- endif -%}
              </video>
              {%- if sound_pos == 'inside' -%}
                {%- if section.settings.sound_label != blank -%}
                  <button type="button" class="lfx-vid__sound" data-lfx-sound aria-pressed="false">
                    <span class="lfx-vid__sound-on">{{ section.settings.sound_label }}</span>
                    <span class="lfx-vid__sound-off">{{ section.settings.mute_label }}</span>
                  </button>
                {%- endif -%}
              {%- endif -%}
              {%- unless section.settings.autoplay -%}
                <button type="button" class="lfx-vid__play" data-lfx-play aria-label="{{ section.settings.play_label | escape }}">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                </button>
              {%- endunless -%}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'lfx-media__placeholder' }}
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- if sound_pos == 'below' and video != blank and section.settings.sound_label != blank -%}
        <button type="button" class="lfx-vid__sound lfx-vid__sound--below" data-lfx-sound aria-pressed="false">
          <span class="lfx-vid__sound-on">{{ section.settings.sound_label }}</span>
          <span class="lfx-vid__sound-off">{{ section.settings.mute_label }}</span>
        </button>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'sticker' -%}
          {% render 'landing-fx-sticker', block: block %}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="lfx-vid__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="lfx-vid__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lfx-heading lfx-vid__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lfx-vid__body landing-marker">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="lfx-vid__cta">
          {% render 'landing-button', label: section.settings.button_label, link: section.settings.button_link %}
          {%- if section.settings.note != blank -%}
            <p class="lfx-vid__note">{{ section.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% render 'landing-divider' %}

<script>
  (function () {
    var root = document.querySelector('.lfx-vid--{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var video = root.querySelector('[data-lfx-video]');
    if (!video) return;
    var sound = root.querySelector('[data-lfx-sound]');
    var play = root.querySelector('[data-lfx-play]');
    var auto = video.dataset.autoplay === 'true';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var userPaused = false;

    function tryPlay() {
      var p = video.play();
      if (p && p.catch) p.catch(function () { root.classList.add('is-blocked'); });
    }
    function setSound(on) {
      video.muted = !on;
      root.classList.toggle('is-sound', on);
      if (sound) sound.setAttribute('aria-pressed', on ? 'true' : 'false');
    }

    if (sound) {
      sound.addEventListener('click', function (e) {
        e.stopPropagation();
        var on = video.muted;
        setSound(on);
        if (on && video.paused) { userPaused = false; tryPlay(); }
      });
    }
    if (play) {
      play.addEventListener('click', function () {
        root.classList.add('is-started');
        setSound(true);
        tryPlay();
      });
    }
    video.addEventListener('click', function () {
      if (video.paused) { userPaused = false; tryPlay(); }
      else if (video.muted) { setSound(true); }
      else { userPaused = true; video.pause(); }
    });
    video.addEventListener('playing', function () { root.classList.add('is-playing', 'is-started'); root.classList.remove('is-blocked'); });
    video.addEventListener('pause', function () { root.classList.remove('is-playing'); });

    if (!auto || reduce) { video.preload = 'metadata'; return; }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
            if (!userPaused && video.paused) tryPlay();
          } else if (!video.paused) {
            video.pause();
          }
        });
      }, { threshold: [0, 0.4, 0.8] }).observe(video);
    } else {
      tryPlay();
    }
  })();
</script>

{% style %}
  .lfx-vid--{{ section.id }} {
    --lfx-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --lfx-ink: {{ section.settings.ink_color }};
    --lfx-shadow: {{ section.settings.shadow_color }};
    --lfx-offset: {{ section.settings.shadow_offset }}px;
    --lm-color: {{ section.settings.marker_color | color_modify: 'alpha', 0.5 }};
    --lb-bg: {{ section.settings.button_bg_color }};
    --lb-text: {{ section.settings.button_text_color }};
    --lb-border: {{ section.settings.button_border_color }};
    --lb-shadow: {{ section.settings.ink_color }};
    --lb-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  }
  .lfx-vid--{{ section.id }} .lfx-vid__inner {
    display: grid;
    gap: 40px;
    align-items: center;
    max-width: 1240px;
    margin-inline: auto;
    padding: {{ section.settings.padding_mobile }}px 18px {{ section.settings.padding_mobile | plus: 8 }}px;
  }
  .lfx-vid--{{ section.id }} .lfx-vid__media {
    position: relative;
    width: min(100%, {{ section.settings.video_width_mobile }}px);
    margin-inline: auto;
  }
  .lfx-vid--{{ section.id }} .lfx-vid__tilt { transform: rotate({{ section.settings.video_tilt }}deg); }
  .lfx-vid--{{ section.id }} .lfx-media__img { background: #000; }
  .lfx-vid--{{ section.id }} .lfx-vid__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }
  .lfx-vid--{{ section.id }} .lfx-vid__sound {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    padding: 8px 12px 7px;
    border: 2px solid var(--lfx-ink);
    border-radius: 999px;
    background: {{ section.settings.sound_bg }};
    color: {{ section.settings.sound_text }};
    box-shadow: 3px 3px 0 var(--lfx-ink);
    font-family: var(--lfx-head);
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lfx-vid--{{ section.id }} .lfx-vid__sound--below { position: relative; left: auto; bottom: auto; display: block; width: max-content; margin: 26px auto 0; }
  .lfx-vid--{{ section.id }} .lfx-vid__sound-off { display: none; }
  .lfx-vid--{{ section.id }}.is-sound .lfx-vid__sound-on { display: none; }
  .lfx-vid--{{ section.id }}.is-sound .lfx-vid__sound-off { display: inline; }
  .lfx-vid--{{ section.id }} .lfx-vid__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding: 0;
    border: 3px solid var(--lfx-ink);
    border-radius: 50%;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    box-shadow: 4px 4px 0 var(--lfx-ink);
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  .lfx-vid--{{ section.id }} .lfx-vid__play svg { width: 38px; height: 38px; margin-left: 4px; }
  .lfx-vid--{{ section.id }}.is-started .lfx-vid__play { display: none; }
  .lfx-vid--{{ section.id }} .lfx-vid__copy { max-width: 560px; margin-inline: auto; }
  .lfx-vid--{{ section.id }} .lfx-vid__kicker {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 12px 7px;
    border: 2px solid var(--lfx-ink);
    background: {{ section.settings.kicker_bg }};
    color: {{ section.settings.kicker_text }};
    box-shadow: 4px 4px 0 var(--lfx-ink);
    font-family: var(--lfx-head);
    font-size: 15px;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .lfx-vid--{{ section.id }} .lfx-vid__heading { font-size: {{ section.settings.heading_size_mobile }}px; line-height: 1.02; margin-bottom: 20px; }
  .lfx-vid--{{ section.id }} .lfx-vid__body { font-size: 17px; line-height: 1.5; }
  .lfx-vid--{{ section.id }} .lfx-vid__body p { margin: 0 0 14px; }
  .lfx-vid--{{ section.id }} .lfx-vid__body p:last-child { margin-bottom: 0; }
  .lfx-vid--{{ section.id }} .lfx-vid__body strong { font-weight: 700; }
  .lfx-vid--{{ section.id }} .lfx-vid__cta { display: flex; flex-direction: column; gap: 12px; margin-top: 26px; }
  .lfx-vid--{{ section.id }} .lfx-vid__note { margin: 0; font-size: 15px; text-align: center; }

  {%- if section.settings.copy_first_mobile %}
  @media (max-width: 989px) {
    .lfx-vid--{{ section.id }} .lfx-vid__copy { order: -1; }
  }
  {%- endif %}

  @media (min-width: 990px) {
    .lfx-vid--{{ section.id }} .lfx-vid__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 88px;
      padding: {{ section.settings.padding_desktop }}px 40px {{ section.settings.padding_desktop | plus: 8 }}px;
    }
    .lfx-vid--{{ section.id }}.lfx-cut--media-right .lfx-vid__media { order: 2; }
    .lfx-vid--{{ section.id }} .lfx-vid__media { width: 100%; max-width: {{ section.settings.video_width_desktop }}px; }
    .lfx-vid--{{ section.id }}.lfx-cut--media-left .lfx-vid__media { justify-self: end; }
    .lfx-vid--{{ section.id }} .lfx-vid__copy { margin-inline: 0; }
    .lfx-vid--{{ section.id }} .lfx-vid__heading { font-size: {{ section.settings.heading_size_desktop }}px; }
    .lfx-vid--{{ section.id }} .lfx-vid__body { font-size: 18px; }
    .lfx-vid--{{ section.id }} .lfx-vid__cta { max-width: 420px; }
  }
{% endstyle %}

{% schema %}
