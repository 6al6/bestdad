,"label":"Video width (mobile)","min":240,"max":600,"step":10,"unit":"px","default":420},{"type":"range","id":"video_width_desktop","label":"Video width (desktop)","min":300,"max":640,"step":10,"unit":"px","default":460},{"type":"range","id":"video_tilt","label":"Video tilt","min":-8,"max":8,"step":1,"unit":"°","default":-2},{"type":"range","id":"shadow_offset","label":"Shadow offset","min":0,"max":30,"step":2,"unit":"px","default":14},{"type":"header","content":"Text"},{"type":"text","id":"kicker","label":"Label above heading","default":"30 seconds"},{"type":"text","id":"heading","label":"Heading","default":"Rip it out. Play. Stick the proof."},{"type":"range","id":"heading_size_mobile","label":"Heading size (mobile)","min":24,"max":60,"step":2,"unit":"px","default":34},{"type":"range","id":"heading_size_desktop","label":"Heading size (desktop)","min":30,"max":80,"step":2,"unit":"px","default":50},{"type":"richtext","id":"body","label":"Text","info":"Underline renders as a highlighter marker.","default":"<p>Tear out a mission. Read the script. Your kid awards the sticker.</p>"},{"type":"checkbox","id":"copy_first_mobile","label":"Text above the video on phones","default":false},{"type":"header","content":"Button"},{"type":"text","id":"button_label","label":"Button label","default":"Get the kit"},{"type":"url","id":"button_link","label":"Button link","info":"E.g. #product-offer-1 to jump to the buy box."},{"type":"text","id":"note","label":"Note under button"},{"type":"text","id":"anchor_id","label":"Anchor ID","info":"Lets buttons link here with #id. Leave blank for none."},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_mobile","label":"Top and bottom padding (mobile)","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_desktop","label":"Top and bottom padding (desktop)","min":0,"max":160,"step":4,"unit":"px","default":88},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#fef1d5"},{"type":"color","id":"text_color","label":"Text","default":"#2b2d45"},{"type":"color","id":"ink_color","label":"Outline","default":"#2b2d45"},{"type":"color","id":"shadow_color","label":"Video shadow","default":"#ee614c"},{"type":"color","id":"marker_color","label":"Highlighter","default":"#ee614c"},{"type":"color","id":"kicker_bg","label":"Label background","default":"#f6b52e"},{"type":"color","id":"kicker_text","label":"Label text","default":"#2b2d45"},{"type":"color","id":"sound_bg","label":"Sound button background","default":"#fef1d5"},{"type":"color","id":"sound_text","label":"Sound button text","default":"#2b2d45"},{"type":"color","id":"button_bg_color","label":"Button background","default":"#f72828"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"button_border_color","label":"Button inner border","default":"#fef1d5"},{"type":"header","content":"Wavy divider"},{"type":"color","id":"divider_top_color","label":"Top divider color","info":"Pick the color of the section ABOVE to show a wavy edge at the top. Use Clear to remove it."},{"type":"color","id":"divider_bottom_color","label":"Bottom divider color","info":"Pick the color of the section BELOW to show a wavy edge at the bottom. Use Clear to remove it."},{"type":"select","id":"divider_style","label":"Divider style","options":[{"value":"waves-1-patterned_1200x20","label":"Waves 1 (small)"},{"value":"waves-2-patterned_1200x43","label":"Waves 2 (medium)"},{"value":"waves-3-patterned_1200x84","label":"Waves 3 (large)"},{"value":"zig-zag-2-patterned_1200x37","label":"Zig-zag"},{"value":"circles-2-patterned_1200x35","label":"Circles"},{"value":"spikes-1-patterned_1200x132","label":"Spikes"}],"default":"waves-1-patterned_1200x20"},{"type":"checkbox","id":"divider_animate","label":"Animate divider","default":true}],"blocks":[{"type":"sticker","name":"Sticker","settings":[{"type":"select","id":"kind","label":"Sticker type","options":[