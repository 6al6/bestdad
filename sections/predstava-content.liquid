{% comment %}
  Predstava landing page section.
  Generated from the reviewed mockup — scoped under .predstava-page so it
  cannot leak into or be affected by the theme's own styles.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
(function () {
  var link = document.createElement('link');
  link.rel = 'icon';
  link.type = 'image/png';
  link.href = "{{ 'favicon.png' | asset_url }}";
  document.head.appendChild(link);
})();
</script>
<style>
.predstava-layout { margin: 0; }
@font-face { font-family: 'Resolution'; src: url({{ 'Resolution-Regular.otf' | asset_url }}) format('opentype'); font-weight: 400; font-display: swap; }
.predstava-page {
    --bg: #FEF0D5;
    --bg-alt: #F5E1B9;
    --surface: #FFF9E6;
    --ink: #2A2D45;
    --ink-soft: #5B5D77;
    --ink-faint: #8B8CA0;
    --coral: #EE614C;
    --coral-on: #FBE0D7;
    --coral-deep: #A6402B;
    --coral-tint: #FBE0D7;
    --amber: #E2A23C;
    --amber-deep: #7A5314;
    --border: rgba(42,45,69,0.14);
    --border-strong: rgba(42,45,69,0.28);
    --shadow-color: rgba(42,45,69,0.16);
    --panel-bg: #2A2D45;
    --panel-text: #E5E7EB;
  }
@media (prefers-color-scheme: dark) {
.predstava-page:not([data-theme="light"]) {
      --bg: #1A1A26;
      --bg-alt: #22222F;
      --surface: #262637;
      --ink: #F2EEE2;
      --ink-soft: #C2BFD6;
      --ink-faint: #8B8AA0;
      --coral: #EE614C;
      --coral-on: #FBE0D7;
      --coral-deep: #F7B8AF;
      --coral-tint: #3D2620;
      --amber: #EFC26B;
      --amber-deep: #F2D08C;
      --border: rgba(242,238,226,0.16);
      --border-strong: rgba(242,238,226,0.3);
      --shadow-color: rgba(0,0,0,0.4);
      --panel-bg: #12121A;
      --panel-text: #E5E7EB;
    }
  }
.predstava-page[data-theme="dark"] {
    --bg: #1A1A26;
    --bg-alt: #22222F;
    --surface: #262637;
    --ink: #F2EEE2;
    --ink-soft: #C2BFD6;
    --ink-faint: #8B8AA0;
    --coral: #EE614C;
    --coral-on: #FBE0D7;
    --coral-deep: #F7B8AF;
    --coral-tint: #3D2620;
    --amber: #EFC26B;
    --amber-deep: #F2D08C;
    --border: rgba(242,238,226,0.16);
    --border-strong: rgba(242,238,226,0.3);
    --shadow-color: rgba(0,0,0,0.4);
    --panel-bg: #12121A;
    --panel-text: #E5E7EB;
  }
.predstava-page * { box-sizing: border-box; }
.predstava-page {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Rubik', ui-sans-serif, system-ui, sans-serif;
    line-height: 1.65;
  }
.predstava-page img { max-width: 100%; display: block; }
.predstava-page a { color: inherit; }
.predstava-page .pf-wrap { max-width: 1512px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 64px); }
.predstava-page .pf-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #EE614C;
    display: inline-block;
  }
.predstava-page .pf-eyebrow::before { content: "/ "; }
.predstava-page h1, .predstava-page h2 {
    font-family: 'Dela Gothic One', ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    text-wrap: balance;
    color: var(--ink);
    margin: 0;
    text-transform: uppercase;
  }
.predstava-page .num { font-family: 'Resolution', ui-monospace, monospace; }
.predstava-page header {
    position: relative;
    padding: 20px 0;
    border-bottom: 0.5px solid var(--border);
  }
.predstava-page .pf-header-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.predstava-page .pf-wordmark { display: flex; flex-direction: column; gap: 1px; }
.predstava-page .pf-wordmark .pf-top { font-family: 'Dela Gothic One'; font-size: 17px; letter-spacing: 0.01em; text-transform: uppercase; }
.predstava-page .pf-wordmark .pf-bottom { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--coral-deep); font-weight: 700; }
.predstava-page nav { display: flex; gap: clamp(14px, 3vw, 28px); font-size: 14.5px; font-weight: 700; flex-wrap: wrap; }
.predstava-page .header-actions { display: flex; align-items: center; gap: 8px; }
.predstava-page .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    margin: -8px 0;
    cursor: pointer;
    color: var(--ink);
  }
.predstava-page .menu-toggle svg { width: 24px; height: 24px; display: block; }
.predstava-page nav a { text-decoration: none; color: var(--ink-soft); border-bottom: 2px solid transparent; padding-bottom: 2px; }
.predstava-page nav a:hover { color: var(--ink); border-color: var(--coral); }
.predstava-page .pf-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Rubik', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    border: 0.5px solid transparent;
  }
.predstava-page .pf-btn-primary {
    position: relative;
    background-color: #EE614C;
    background-image: repeating-linear-gradient(to bottom, var(--bg) 0 3px, transparent 3px 7px);
    background-repeat: no-repeat;
    background-position: 28px center;
    background-size: 1.5px calc(100% - 14px);
    color: #FBE0D7;
    border-radius: 4px;
    padding: 11px 22px 11px 40px;
    transform: rotate(-3deg);
    box-shadow: 0 3px 0 var(--shadow-color);
    transition: all 0.3s ease-in-out;
    font-size: 20px !important;
  }
.predstava-page .pf-btn-primary::before, .predstava-page .pf-btn-primary::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 13px; height: 13px;
    background: var(--bg);
    border: none;
    box-shadow: none;
    outline: none;
    border-radius: 50%;
    box-sizing: border-box;
    transform: translateY(-50%);
  }
.predstava-page .pf-btn-primary::before { left: -6.5px; }
.predstava-page .pf-btn-primary::after { right: -6.5px; }
.predstava-page .pf-btn-primary:hover { transform: rotate(3deg); transition: all 0.3s ease-in-out; }
.predstava-page .pf-btn-ghost {
    background: none;
    border: none;
    padding: 11px 4px;
    color: var(--ink);
  }
.predstava-page .pf-btn-ghost:hover { color: var(--coral); }
.predstava-page .pf-hero {
    position: relative;
    padding-top: clamp(48px, 8vw, 80px);
  }
.predstava-page .pf-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }
.predstava-page .pf-hero h1 {
    font-size: clamp(30px, 5vw, 56px);
    line-height: 1.18;
    letter-spacing: 0.015em;
  }
.predstava-page .pf-hero-taglines {
    margin: 22px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 36px !important;
  }
.predstava-page .pf-hero-taglines p {
    font-family: 'Resolution', ui-monospace, monospace;
    text-transform: uppercase;
    font-size: clamp(13px, 1.6vw, 15px);
    letter-spacing: 0.01em;
    color: var(--coral-deep);
    margin: 0;
    line-height: 1.5;
  }
.predstava-page .pf-hero-cta { display: flex; gap: 20px; margin-top: 32px; flex-wrap: wrap; align-items: center; }
.predstava-page .pf-hero-photo-wrap {
    position: relative;
  }
.predstava-page .pf-hero-photo-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #EE614C;
    border: 3px solid #FEF0D5;
    border-radius: 16px;
    transform: translate(9px, 9px);
    z-index: 0;
  }
.predstava-page .pf-hero-photo-inner {
    position: relative;
    z-index: 1;
    background: var(--bg);
    border-radius: 16px;
    overflow: hidden;
    border: 0.5px solid var(--border);
    aspect-ratio: 4/3.1;
  }
.predstava-page .pf-hero-photo-inner img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.predstava-page .pf-facts-strip {
    background: transparent;
    color: var(--panel-text);
    margin-top: clamp(40px, 7vw, 64px);
  }
.predstava-page .pf-facts-strip .pf-wrap {
    display: flex;
    flex-wrap: wrap;
    padding: 22px clamp(20px, 5vw, 64px);
  }
.predstava-page .pf-facts-strip .pf-fact {
    flex: 1;
    min-width: 200px;
    padding: 4px clamp(20px, 3vw, 40px);
    border-left: 1px solid rgba(254,240,213,0.16);
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
.predstava-page .pf-facts-strip .pf-fact:first-child { border-left: none; padding-left: 0; }
.predstava-page section { padding: clamp(52px, 9vw, 84px) 0; }
.predstava-page section.pf-alt { background: var(--bg-alt); }
.predstava-page #o-predstavi { background: #FEF0D5; }
.predstava-page #o-predstavi h2, .predstava-page #o-predstavi .pf-about-body p { color: #2A2D45; }
@media (min-width: 1080px) {
.predstava-page #o-predstavi .pf-section-head { max-width: none; }
.predstava-page #o-predstavi h2 { white-space: nowrap; font-size: 30px; }
  }
.predstava-page #zasedba h2 { white-space: nowrap; font-size: clamp(17px, 3.6vw, 34px); }
.predstava-page .pf-section-head { max-width: 900px; margin-bottom: 36px; }
.predstava-page .pf-section-head h2 { font-size: clamp(20px, 3.6vw, 34px); margin-top: 14px; }
.predstava-page .pf-section-head p { color: var(--ink-soft); margin: 14px 0 0; max-width: 60ch; font-size: 15.5px; }
.predstava-page .pf-about-body {
    column-count: 2;
    column-gap: clamp(32px, 5vw, 64px);
  }
.predstava-page .pf-about-body p { font-size: 16px; color: var(--ink); margin: 0 0 16px; break-inside: avoid; }
.predstava-page .pf-cast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }
.predstava-page .pf-cast-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
.predstava-page .pf-cast-photo {
    aspect-ratio: 3/4;
    background:
      repeating-linear-gradient(135deg, var(--border) 0 10px, transparent 10px 20px),
      var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    position: relative;
  }
.predstava-page .pf-cast-photo svg { width: 44px; height: 44px; opacity: 0.55; }
.predstava-page .pf-cast-info { padding: 14px 16px 16px; }
.predstava-page .pf-cast-info .pf-name { font-family: 'Dela Gothic One'; font-size: 16px; text-transform: uppercase; }
.predstava-page .pf-cast-info .pf-role { font-size: 13px; color: var(--ink-soft); margin-top: 3px; }
.predstava-page .cast-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px;
    background: rgba(42,45,69,0.6);
    color: #FEF0D5;
    font-family: 'Dela Gothic One';
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
.predstava-page .cast-info-spacer { padding: 14px 16px 16px; visibility: hidden; }
.predstava-page .cast-info-spacer .pf-name { font-family: 'Dela Gothic One'; font-size: 16px; }
.predstava-page .cast-info-spacer .pf-role { font-size: 13px; margin-top: 3px; }
.predstava-page .pf-months-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 48px); }
.predstava-page .age-notice {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
    padding: 20px 20px;
    background: var(--surface);
    border: 1.5px dashed var(--border-strong);
    border-radius: 12px;
  }
.predstava-page .age-notice-header {
    display: flex;
    align-items: center;
    gap: 18px;
  }
.predstava-page .age-badge {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--coral);
    color: #FBE0D7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Dela Gothic One';
    font-size: 17px;
    transform: rotate(-4deg);
    box-shadow: 0 3px 0 var(--shadow-color);
  }
.predstava-page .age-notice-title { font-weight: 700; color: var(--ink); font-size: 15.5px; margin: 0; }
.predstava-page .age-notice-text { font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); margin: 0; }
.predstava-page .pf-month-group { margin-bottom: 0; }
.predstava-page .pf-month-label {
    font-family: 'Dela Gothic One';
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    margin: 0 0 12px;
  }
.predstava-page .pf-venue-list { display: flex; flex-direction: column; gap: 10px; }
.predstava-page .pf-venue-row {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    align-items: center;
    gap: 18px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 10px;
    padding: 14px 20px;
    position: relative;
  }
.predstava-page .pf-venue-row::before, .predstava-page .pf-venue-row::after {
    content: "";
    position: absolute;
    width: 16px; height: 16px;
    background: var(--bg);
    border-radius: 50%;
    top: 50%; transform: translateY(-50%);
  }
.predstava-page section.pf-alt .pf-venue-row::before, .predstava-page section.pf-alt .pf-venue-row::after { background: var(--bg-alt); }
.predstava-page .pf-venue-row::before { left: 72px; margin-left: -8px; }
.predstava-page .pf-venue-row::after { right: 0; margin-right: -8px; }
.predstava-page .pf-venue-date { font-family: 'Resolution'; font-size: 12.5px; color: var(--coral-deep); font-weight: 400; line-height: 1.25; border-right: 1.5px dashed var(--border-strong); padding-right: 14px; }
.predstava-page .pf-venue-date .pf-day { display: block; font-size: 20px; color: var(--ink); font-family: 'Dela Gothic One'; }
.predstava-page .pf-venue-main { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.predstava-page .pf-venue-main .pf-city { font-weight: 700; font-size: 15px; }
.predstava-page .pf-venue-time { font-size: 13.5px; color: var(--ink-soft); white-space: nowrap; text-align: right; }
.predstava-page .pf-venue-time .pf-warn { color: var(--coral-deep); font-weight: 700; }
.predstava-page .pf-venue-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    font-family: 'Rubik', sans-serif;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.01em;
    padding: 9px 16px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    background: var(--coral);
    color: var(--coral-on);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
.predstava-page .pf-venue-cta:hover { background: var(--coral-deep); transform: translateY(-1px); }
.predstava-page #vstopnice { background: var(--bg); padding-top: clamp(32px, 6vw, 56px); padding-bottom: clamp(64px, 11vw, 104px); }
.predstava-page .pf-tickets-band-wrap {
    position: relative;
  }
.predstava-page .pf-tickets-band-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #FEF0D5;
    border: 3px solid #EE614C;
    border-radius: 20px;
    transform: translate(20px, 20px);
    z-index: 0;
  }
.predstava-page .pf-tickets-band {
    position: relative;
    z-index: 1;
    background: var(--coral);
    color: var(--panel-bg);
    border-radius: 20px;
    padding: clamp(40px, 7vw, 64px) clamp(28px, 6vw, 52px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
.predstava-page .pf-tickets-mascot {
    position: absolute;
    z-index: 2;
    left: clamp(6px, 3vw, 28px);
    bottom: 0;
    width: clamp(96px, 12vw, 150px);
    height: auto;
    pointer-events: none;
    transform: translateY(18%) rotate(8deg);
    opacity: 1;
  }
.predstava-page .pf-tickets-pretitle {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.72;
  }
.predstava-page .pf-tickets-band h2 { font-size: clamp(26px, 4vw, 40px); color: inherit; margin-top: 8px; max-width: 18ch; }
.predstava-page .pf-btn-primary-inverse {
    background-color: #FBE0D7;
    background-image: repeating-linear-gradient(to bottom, #EE614C 0 3px, transparent 3px 7px);
    color: #EE614C;
    margin-top: 28px;
  }
.predstava-page .pf-btn-primary-inverse::before, .predstava-page .pf-btn-primary-inverse::after { background: #EE614C; border: none; box-shadow: none; outline: none; }
.predstava-page .pf-btn-primary-inverse:hover { background-color: #FEF0D5; }
.predstava-page footer {
    border-top: 0.5px solid var(--border);
    font-size: 13.5px;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
.predstava-page footer.pf-wrap { padding-top: 32px; padding-bottom: 42px; }
.predstava-page footer a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: 2px; }
@media (max-width: 760px) {
.predstava-page .pf-hero { padding-bottom: 65px !important; }
.predstava-page .pf-hero-grid { grid-template-columns: 1fr; }
.predstava-page .pf-hero-photo-wrap { order: -1; }
.predstava-page .pf-about-body { column-count: 1; }
.predstava-page .pf-facts-strip { display: none !important; }
.predstava-page .pf-facts-strip .pf-fact { border-left: none; padding-left: 0; flex-basis: 100%; }
.predstava-page .pf-months-grid { grid-template-columns: 1fr; gap: 32px; }
.predstava-page .pf-cast-grid { grid-template-columns: 1fr; }
.predstava-page .pf-tickets-band-wrap::before { transform: translate(8px, 8px); }
.predstava-page .pf-tickets-mascot { width: 55px; }
.predstava-page h2 { line-height: 32px !important; }
.predstava-page #o-predstavi h2 .v1-break { display: block; }
.predstava-page .header-actions .pf-btn-primary { display: none; }
.predstava-page .menu-toggle { display: inline-flex; align-items: center; justify-content: center; }
.predstava-page .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      background: var(--bg);
      border-bottom: 0.5px solid var(--border);
      padding: 12px clamp(20px, 5vw, 64px) 18px;
      z-index: 50;
    }
.predstava-page .site-nav.is-open { display: flex; }
.predstava-page .site-nav a { padding: 10px 0; border-bottom: 0.5px solid var(--border); }
.predstava-page .site-nav a:last-child { border-bottom: none; }
  }
@media (max-width: 560px) {
.predstava-page .pf-venue-row { grid-template-columns: 1fr; }
.predstava-page .pf-venue-date { border-right: none; padding-right: 0; border-bottom: 1.5px dashed var(--border-strong); padding-bottom: 8px; display: flex; align-items: baseline; gap: 8px; }
.predstava-page .pf-venue-date .pf-day { font-size: 16px; }
.predstava-page .pf-venue-row::before, .predstava-page .pf-venue-row::after { display: none; }
.predstava-page .pf-venue-time { text-align: left; }
.predstava-page .pf-venue-cta { justify-self: start; margin-top: 2px; }
  }
@media (prefers-reduced-motion: no-preference) {
.predstava-page .pf-hero h1, .predstava-page .pf-hero-taglines, .predstava-page .pf-hero-cta { animation: rise 0.6s ease both; margin-top: 18px; }
.predstava-page .pf-hero-taglines { animation-delay: 0.08s; }
.predstava-page .pf-hero-cta { animation-delay: 0.16s; }
.predstava-page .pf-btn-primary-inverse { animation: ticket-shake 2s ease-in-out infinite; }
.predstava-page .pf-hero-cta .pf-btn-primary { animation: ticket-shake 2s ease-in-out infinite; }
.predstava-page .pf-tickets-mascot {
      transform: translateY(85%) rotate(8deg);
      opacity: 0;
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s, opacity 0.6s ease 0.2s;
    }
.predstava-page .pf-tickets-mascot.is-visible {
      transform: translateY(18%) rotate(8deg);
      opacity: 1;
    }
  }
@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes ticket-shake {
