{{ 'landing-fx.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-fx.js' | asset_url }}" defer></script>

<div class="lfx-layer lfx-layer--{{ section.id }}" aria-hidden="true">
  <div class="lfx-layer__box">
    {%- for block in section.blocks -%}
      {% render 'landing-fx-sticker', block: block %}
    {%- endfor -%}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 40;
    height: 0;
    overflow: visible;
  }
  .lfx-layer--{{ section.id }} {
    --lfx-head: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    position: absolute;
    left: 0;
    right: 0;
    top: calc({{ section.settings.height }}px / -2);
    height: {{ section.settings.height }}px;
    overflow-x: clip;
    pointer-events: none;
  }
  .lfx-layer--{{ section.id }} .lfx-layer__box {
    position: relative;
    max-width: 1440px;
    height: 100%;
    margin-inline: auto;
  }
{% endstyle %}

{% schema %}
