{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ section.settings.padding_vertical }}px {{ section.settings.padding_horizontal }}px;
    background-color: {{ section.settings.background_color }};
    {% if section.settings.show_border %}
      border-bottom: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    {% endif %}
  }

  .ai-page-header__logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    max-width: {{ section.settings.logo_max_width }}px;
  }

  .ai-page-header__logo-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-page-header__logo-placeholder-{{ ai_gen_id }} {
    width: {{ section.settings.logo_max_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-page-header__logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 100px;
    max-height: 50px;
  }

  .ai-page-header__text-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    margin: 0;
    padding: 0 20px;
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    font-style: {{ section.settings.text_font.style }};
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-page-header-{{ ai_gen_id }} {
      padding: {{ section.settings.padding_vertical | times: 0.7 }}px {{ section.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-page-header__logo-{{ ai_gen_id }} {
      max-width: {{ section.settings.logo_max_width | times: 0.7 }}px;
    }

    .ai-page-header__logo-placeholder-{{ ai_gen_id }} {
      width: {{ section.settings.logo_max_width | times: 0.7 }}px;
      height: 42px;
    }

    .ai-page-header__text-{{ ai_gen_id }} {
      font-size: {{ section.settings.text_size | times: 0.8 }}px;
      padding: 0 10px;
    }
  }
{% endstyle %}

{% if section.settings.enable_header %}
  {% liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
%}
  <div class="ai-page-header-{{ ai_gen_id }}">
    <div class="ai-page-header__logo-{{ ai_gen_id }}">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ section.settings.logo.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-page-header__logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <h1 class="ai-page-header__text-{{ ai_gen_id }}">
      {{ section.settings.header_text }}
    </h1>
  </div>
{% endif %}

{% schema %}
{
  "name": "AI Landing Page Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_header",
      "label": "Enable header",
      "default": true
    },

    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Maximum width",
      "default": 150
    },

    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header text",
      "default": "Welcome to our store"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "prompt_n9"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#162317"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f4fbf2"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 30
    },

    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": true
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "default": "#162317"
    }
  ],
  "blocks": [
  {
    "type": "sticker",
    "name": "Sticker",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Sticker image" },
      { "type": "range", "id": "width", "label": "Width", "min": 40, "max": 200, "step": 5, "default": 100 },
      { "type": "range", "id": "horizontal_position", "label": "Horizontal position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
      { "type": "range", "id": "vertical_position", "label": "Vertical position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
      { "type": "range", "id": "rotate", "label": "Rotation", "min": -180, "max": 180, "step": 5, "default": 0 },
      { "type": "checkbox", "id": "show_sticker_on_mobile", "label": "Show on mobile", "default": true },
      { "type": "checkbox", "id": "show_sticker_on_desktop", "label": "Show on desktop", "default": true }
    ]
  }
],
  "presets": [
    {
      "name": "AI Landing Header"
    }
  ]
}
{% endschema %}
  