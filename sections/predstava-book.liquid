{% comment %}
  Book block for the show page (/pages/predstava). It lives in its own section so
  the show content in predstava-content-full.liquid stays untouched. It reuses that
  section's .predstava-page styles and colour variables.
  The script at the end moves the block above the copyright line. Without
  JavaScript the block simply shows below it.
{% endcomment %}
{%- assign book_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
{%- comment -%} The button link carries a campaign tag so clicks on this block can be counted. The link on the book's name stays untagged. {%- endcomment -%}
{%- assign book_url_tagged = book_url | append: '?utm_source=predstava&amp;utm_medium=internal&amp;utm_campaign=knjiga_blok' -%}
<style>
.predstava-page .pf-book { display: flex; flex-direction: column; align-items: center; text-align: center; }
.predstava-page .pf-book-pretitle { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--coral-deep); }
.predstava-page .pf-book h2 { font-size: clamp(22px, 3.6vw, 36px); margin-top: 10px; max-width: 26ch; }
.predstava-page .pf-book p { color: var(--ink-soft); margin: 18px 0 0; max-width: 58ch; font-size: 16.5px; }
.predstava-page .pf-book p a { text-decoration: underline; text-underline-offset: 3px; }
.predstava-page .pf-book-btn { margin-top: 28px; background: var(--ink); color: var(--bg); padding: 13px 26px; font-size: 16px; }
.predstava-page .pf-book-btn:hover { opacity: 0.88; }
</style>
<div class="predstava-page">
  <section class="pf-alt" id="knjiga">
    <div class="pf-wrap">
      <div class="pf-book">
        <span class="pf-book-pretitle">Fotrovski komplet</span>
        <h2>Za spomine, ki ostanejo.</h2>
        <p>Knjiga <a href="{{ book_url }}">Jaz sem najboljši Fotr na svetu</a> Lada Bizovičarja z 28 misijami za fotra in otroka, 28 zlatimi nalepkami in Fotrovskim megaplakatom skupnih dosežkov. Izbereta misijo, jo iztrgata in skupaj izpeljeta. Otrok ti podeli trofejo. Ti končno dobiš dokaze za svojo veličino.</p>
        <a class="pf-btn pf-book-btn" href="{{ book_url_tagged }}">Poglej knjigo</a>
      </div>
    </div>
  </section>
</div>
<script>
(function () {
  var block = document.getElementById('knjiga');
  var footer = document.querySelector('.predstava-page footer');
  if (block && footer && footer.parentNode) footer.parentNode.insertBefore(block, footer);
})();
</script>

{% schema %}
{
  "name": "Predstava: book block",
  "settings": []
}
{% endschema %}