    "faq": {
      "type": "landing-faq",
      "blocks": {
        "question_OR7meZ": {
          "type": "question",
          "settings": {
            "title": "Za katero starost otroka je komplet primeren?",
            "answer": "<p>Za skupno igro fotra in otroka od približno 1 do 12 let. Vsaka misija ni za vsako starost, zato pri izbiri pomagajo oznake v knjigi. Pri malčku več vodi fotr, starejšemu otroku pa lahko prepusti več načrtovanja in izvedbe.</p>"
          }
        },
        "question_uxYl4E": {
          "type": "question",
          "settings": {
            "title": "Lahko misije izpeljejo tudi mame, babice in dedki?",
            "answer": "<p>Lahko. Knjiga je napisana za fotre, pri misijah pa lahko sodelujejo tudi mame, babice, dedki in drugi odrasli, ki so otroku blizu. Za gradnjo utrdbe iz WC-papirja ne preverjamo očetovstva.</p>"
          }
        },
        "question_e4JeZW": {
          "type": "question",
          "settings": {
            "title": "Se bo otrok teh skupnih podvigov res spomnil?",
            "answer": "<p>Ne moremo obljubiti, da si bo zapomnil vsak trenutek. Misije pa fotru in otroku ponudijo nekaj nevsakdanjega, plakat z nalepkami pa priložnost, da podvige znova obujata. Ob njem si lahko pripovedujeta, kaj sta naredila in kaj ju je najbolj nasmejalo. In tako prideta do: »<em>A se spomniš, ko sva …?</em>«</p>"
          }
        },
        "question_TO9a8N": {
          "type": "question",
          "settings": {
            "title": "Kaj s kompletom pridobita fotr in otrok ter kako ju to povezuje?",
            "answer": "<p>Otrok dobi fotrovo pozornost in priložnost, da predlaga, poskusi in skupaj z njim nekaj izpelje. Fotr dobi pripravljene ideje in jasna navodila, zato mu ni treba vsakič izumljati programa. Skupaj nabirata svoje fore in male zmage. Tudi fotri potrebujejo kakšen dokaz, da jim gre.</p>"
          }
        },
        "question_pLuORG": {
          "type": "question",
          "settings": {
            "title": "Zakaj je ta komplet boljši od igrače?",
            "answer": "<p><strong>Ker zraven pride tudi fotr.</strong> Komplet <strong>Jaz sem najboljši fotr na svetu</strong> ponuja 28 idej za podvige, ki jih fotr in otrok izpeljeta skupaj. Igrač ima otrok mogoče že dovolj. Fotra v vlogi pirata pa verjetno še ni imel priložnosti oceniti.</p>"
          }
        },
        "question_gysU5W": {
          "type": "question",
          "settings": {
            "title": "Je to knjiga o starševstvu?",
            "answer": "<p>To je knjiga za uporabo: 28 misij z navodili za skupno akcijo. Fotr izbere misijo, iztrga stran in se z otrokom lotita podviga. Pridige o tem, kaj vse starši delajo narobe, smo izpustili. Virov za to je že dovolj.</p>"
          }
        },
        "question_GkRq9k": {
          "type": "question",
          "settings": {
            "title": "Kako skupaj delujejo misije, nalepke in plakat?",
            "answer": "<p>Fotrovski recept je preprost: <strong>akcija, čustva, ritual, opomnik</strong>. Fotr in otrok izbereta misijo in skupaj ušpičita nekaj nevsakdanjega. Smeh, presenečenje in ponos so del podviga. Opravljeno misijo proslavita z nalepko, Fotrovski megaplakat pa otroka spomni: »<em>To sva naredila midva z očijem.</em>«</p>"
          }
        },
        "question_8aWvJz": {
          "type": "question",
          "settings": {
            "title": "Se lahko misije ponavljajo?",
            "answer": "<p>Lahko. Stran se iztrga enkrat, podvig pa lahko fotr in otrok ponovita ali si izmislita svojo različico. List z navodili lahko shranita za naslednjič. Če je otrok navdušen nad fotrovo piratsko kariero, je ni treba končati po eni odpravi.</p>"
          }
        },
        "question_tBYvwW": {
          "type": "question",
          "settings": {
            "title": "Bo otroku sploh mar za plakat?",
            "answer": "<p>Na njem so njuni podvigi. Otrok lahko sam nalepi nalepko in pove, kaj mu je bilo pri misiji najbolj všeč. Plakat naj visi tam, kjer ga bo videl vsak dan. Tako ima pred očmi, kaj sta s fotrom že izpeljala in kaj ju še čaka.</p>"
          }
        },
        "question_lwGGkV": {
          "type": "question",
          "settings": {
            "title": "Zakaj se iz knjige trgajo strani?",
            "answer": "<p>Strani z misijami so namenjene trganju. Fotr izbere misijo, preveri navodila in iztrga stran za skupno akcijo. To je ena redkih knjig, pri katerih manjkajoče strani pomenijo, da jo nekdo uporablja pravilno.</p>"
          }
        },
        "question_Efudvh": {
          "type": "question",
          "settings": {
            "title": "Koliko časa trajajo misije? Kaj pa, če je fotr zelo zaposlen?",
            "answer": "<p>Krajše misije trajajo približno 15–30 minut, daljše uro ali dve. Ob vsaki so označeni trajanje, potrebščine in priprava. Tako fotr izbere misijo glede na čas, ki ga imata z otrokom. Ni treba vseh 28 izpeljati do nedelje.</p>"
          }
        },
        "question_pIQsCF": {
          "type": "question",
          "settings": {
            "title": "Bo veliko pospravljanja?",
            "answer": "<p>Odvisno od misije. Skrivni pogovor pusti manj posledic kot slikarska seansa. Seznam potrebščin pomaga oceniti, koliko priprav in zaščite prostora bo potrebnih. Pri pospravljanju lahko sodelujeta fotr in otrok. Tudi to je skupna dejavnost, žal.</p>"
          }
        },
        "question_K4nVI3": {
          "type": "question",
          "settings": {
            "title": "Kaj pa, če fotr ni spreten ali mu je nerodno?",
            "answer": "<p>Začne lahko z misijo, pri kateri mu je udobno. Dobi jasna navodila, popolne izvedbe pa nihče ne pričakuje. Če je njegova papirnata ladjica malo postrani, lahko z otrokom še vedno poskusita, ali plava. Ni treba, da je popolno. Mora se samo zgoditi.</p>"
          }
        },
        "question_QadXsM": {
          "type": "question",
          "settings": {
            "title": "Je to dobro darilo za fotra?",
            "answer": "<p>Za fotra, ki bi z otrokom rad kaj počel, pa mu ob »<em>Kaj bova danes?</em>« zmanjka idej, je to zelo uporabno darilo. V kompletu dobi knjigo z misijami, nalepke in plakat, zraven pa še Božičkovo pismo s kuverto s Severnega pola. Plan smo napisali mi. Zasluge bo pobral on.</p>"
          }
        },
        "question_gIzCa3": {
          "type": "question",
          "settings": {
            "title": "Zakaj kupiti komplet že danes?",
            "answer": "<p>Ker »<em>enkrat, ko bo manj dela</em>« rad ostane samo stavek. S kompletom so ideje pri roki, ko se pojavi priložnost za skupno akcijo. Za začetek fotr in otrok izbereta eno misijo. Fotrovska kariera se lahko nadgrajuje sproti.</p>"
          }
        },
        "question_0UMolZ": {
          "type": "question",
          "settings": {
            "title": "Ali jo bo fotr dejansko prebral?",
            "answer": "<p>Knjiga je napisana s humorjem na račun fotrov. Zato ima dobre možnosti, da jo bo odprl tudi zaradi branja. Za prvi podvig pa zadostujejo navodila ene misije. Potem naj knjigo odloži in gre z otrokom v akcijo.</p>"
          }
        },
        "question_ux2v9l": {
          "type": "question",
          "settings": {
            "title": "Je komplet za novopečene fotre, veterane, očime in fotre ob vikendih?",
            "answer": "<p>Za vse naštete. Uporabljajo ga lahko tudi posvojitelji, rejniki in drugi odrasli v očetovski vlogi. Izbira misije je odvisna od otrokove starosti in časa, ki ga imata skupaj. Tudi novopečeni fotr začne s tistimi, ki so primerne za njegovega otroka. Staž pri zlaganju papirnate ladjice tako ali tako ne pomaga nujno.</p>"
          }
        },
        "question_0siCZg": {
          "type": "question",
          "settings": {
            "title": "Je komplet zares uporaben ali je samo darilo za šalo?",
            "answer": "<p>Vsaka misija ima konkreten načrt: kaj fotr in otrok potrebujeta, koliko časa si vzameta in kako se je lotita. Lahko iščeta piratski zaklad, gradita utrdbo ali iz palačink delata umetnine. Humor je priložen. Navodila so uporabna tudi, če se fotr nobeni naši šali ne nasmeje.</p>"
          }
        },
        "question_K1bEtC": {
          "type": "question",
          "settings": {
            "title": "Kaj s kompletom dobi otrok?",
            "answer": "<p>Fotra, ki ima idejo in je pripravljen sodelovati. Skupaj se lotita podvigov, ki lahko postanejo njune zgodbe, na plakatu pa zbirata dokaze o opravljenih misijah. Komplet je napisan za fotra. Pri akciji sta glavna oba.</p>"
          }
        },
        "question_ZBsmYj": {
          "type": "question",
          "settings": {
            "title": "Kaj je vključeno v komplet?",
            "answer": "<p>Vse je vključeno:</p><ul><li>Knjiga z 28 misijami in jasnimi navodili.</li><li>28 nalepk za opravljene misije.</li><li>Fotrovski megaplakat skupnih dosežkov.</li><li>Božičkovo pismo.</li><li>Kuverta s Severnega pola.</li></ul><p><br/>V knjigi so tudi QR-kode za poročila o opravljenih misijah, ki jih lahko fotr deli s familijo.</p>"
          }
        },
        "question_S9Q3hL": {
          "type": "question",
          "settings": {
            "title": "Zakaj so nalepke pomembne in ali lahko naročim dodatne?",
            "answer": "<p>Nalepka je mala proslava skupnega podviga: fotr in otrok sta misijo izpeljala in na Fotrovskem megaplakatu je nov dokaz. Otrok vidi, kaj sta že doživela, in lahko izbere naslednji podvig.</p><p>Dodatne komplete nalepk lahko naročiš posebej: <a href=\"/products/paket-plakat-in-nalepke\" title=\"Paket: Plakat &quot;Dosežki najboljšega Fotra + komplet nalepk\">Paket: Plakat \"Dosežki najboljšega Fotra + komplet nalepk</a>. Tudi če je prvi komplet že na omari.</p>"
          }
        },
        "question_LeAshy": {
          "type": "question",
          "settings": {
            "title": "Je za misije potrebno posebno orodje ali izlet v Bauhaus?",
            "answer": "<p>Večina potrebščin je običajno že doma. Pri vsaki misiji je seznam, zato fotr vnaprej preveri, kaj ima in kaj mora pripraviti ali dokupiti. Najprej pridejo na vrsto domači predali. Izlet v Bauhaus bo moral upravičiti kako drugače.</p>"
          }
        },
        "question_f5kHRb": {
          "type": "question",
          "settings": {
            "title": "So misije varne?",
            "answer": "<p>Odrasli izbere misijo glede na otrokovo starost in sposobnosti, prebere navodila ter je ves čas zraven. Pri vodi, kuhanju, orodju ali drobnih predmetih poskrbi za ustrezne pripomočke in nadzor. Če otroku ali odraslemu nekaj ni prijetno ali varno, misijo prilagodita ali izbereta drugo.</p>"
          }
        },
        "question_65JG0L": {
          "type": "question",
          "settings": {
            "title": "Kaj pa, če otrok hitro izgubi zanimanje?",
            "answer": "<p>Fotr lahko začne s krajšo misijo in otroku prepusti kakšno odločitev. Če ga misija ne pritegne, jo prilagodita, naredita premor ali izbereta drugo. Vseh 28 ni treba izpeljati po vrsti. Knjiga bo počakala. Tudi pirati imajo prost dan.</p>"
          }
        },
        "question_n5mIHV": {
          "type": "question",
          "settings": {
            "title": "Kakšnemu fotru bo komplet všeč?",
            "answer": "<p>Predvsem takšnemu, ki mu je blizu malo fotrovske neumnosti in bi z otrokom rad kaj počel, pa mu včasih zmanjka idej. Dobi jasna navodila za skupne podvige, zato mu ni treba izumljati programa za vsako popoldne. Za prvo misijo zadostuje pripravljenost, da se pridruži igri.</p>"
          }
        },
        "question_wNmRkv": {
          "type": "question",
          "settings": {
            "title": "Kaj pa, če fotr ne mara brati?",
            "answer": "<p>Knjige mu ni treba prebrati od prve do zadnje strani. Po oznakah izbere primerno misijo, prebere navodila in gre z otrokom v akcijo. Če mu branje ne diši, ga bo mogoče prepričalo trganje strani.</p>"
          }
        },
        "question_GT47De": {
          "type": "question",
          "settings": {
            "title": "Kje je knjiga natisnjena in kdaj dobim komplet?",
            "answer": "<p>Knjigo tiskamo v <strong>EU</strong>. Naročilo običajno odpošljemo <strong>naslednji delovni dan</strong>. Dostava po Sloveniji predvidoma traja <strong>1–3 delovne dni od odpreme.</strong></p>"
          }
        }
      },
