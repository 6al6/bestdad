{% doc %}
  Safety net for the EUR (Slovenian market) price format: rewrites any "€19,99"
  left on the page to "19,99 €", including prices the theme doesn't render
  itself (cart drawer apps, other app widgets) and ones added later by JS.
  Theme prices are already formatted by snippets/money.liquid; this only
  catches the rest. Only runs when the visitor's currency is EUR.
{% enddoc %}
{%- if cart.currency.iso_code == 'EUR' -%}
  <script>
    (() => {
      // Only "€" directly followed by a digit, so already-fixed prices ("19,99 €") never match again.
      const pattern = /€(\d[\d.,]*)/g;
      const skip = new Set(['SCRIPT', 'STYLE', 'TEXTAREA', 'NOSCRIPT']);
      const watched = new WeakSet();
      // Amounts we moved a separate "€" onto; if the app later updates only the number, add the € back.
      const splitAmounts = new WeakSet();

      // Next text node after `node` in document order, ignoring empty ones.
      function nextText(node, root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        walker.currentNode = node;
        let next;
        while ((next = walker.nextNode())) if (next.nodeValue.trim()) return next;
        return null;
      }

      function fixNode(node, root) {
        if (node.parentNode && skip.has(node.parentNode.nodeName)) return;
        let value = node.nodeValue;
        // Upcart's "Save {value}" auto-translated as "Shrani" (save a file); for money it's "Prihrani".
        if (value.indexOf('Shrani') !== -1) {
          const reworded = value.replace(/Shrani(?=\s*(?:€|\d))/g, 'Prihrani');
          if (reworded !== value) node.nodeValue = value = reworded;
        }
        if (splitAmounts.has(node) && value.indexOf('€') === -1 && /\d/.test(value)) {
          node.nodeValue = value.replace(/(\d[\d.,]*)/, '$1\u00a0€');
          return;
        }
        if (value.indexOf('€') === -1) return;
        // "€" and the amount in separate elements, e.g. <span>€</span><span>19,99</span> (cart apps like Upcart)
        if (value.trim() === '€') {
          const amount = nextText(node, root || node.getRootNode());
          if (amount && /^\s*\d/.test(amount.nodeValue)) {
            node.nodeValue = '';
            splitAmounts.add(amount);
            amount.nodeValue = amount.nodeValue.replace(/(\d[\d.,]*)/, '$1\u00a0€');
          }
          return;
        }
        const fixed = value.replace(pattern, '$1\u00a0€');
        if (fixed !== value) node.nodeValue = fixed;
      }

      function fixTree(root) {
        if (root.nodeType === Node.TEXT_NODE) return fixNode(root);
        if (root.nodeType !== Node.ELEMENT_NODE && root.nodeType !== Node.DOCUMENT_FRAGMENT_NODE) return;
        if (skip.has(root.nodeName)) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
        let node = root;
        do {
          if (node.nodeType === Node.TEXT_NODE) fixNode(node, root);
          // Cart apps (Upcart) render inside a shadow root, which the page-level observer can't see.
          else if (node.shadowRoot) watch(node.shadowRoot);
        } while ((node = walker.nextNode()));
      }

      function watch(root) {
        if (watched.has(root)) return;
        watched.add(root);
        fixTree(root);
        new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.type === 'characterData') fixNode(mutation.target);
            else mutation.addedNodes.forEach(fixTree);
          }
        }).observe(root, { childList: true, subtree: true, characterData: true });
      }

      // Shadow roots attached after page load (Upcart loads after the theme).
      const attachShadow = Element.prototype.attachShadow;
      Element.prototype.attachShadow = function (init) {
        const shadow = attachShadow.call(this, init);
        setTimeout(() => watch(shadow));
        return shadow;
      };

      if (document.body) watch(document.body);
      else document.addEventListener('DOMContentLoaded', () => watch(document.body));
    })();
  </script>
{%- endif -%}