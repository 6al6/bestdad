{% doc %}
  Line icon (24px grid), drawn with currentColor.

  @param {string} name - star | heart | clock | shield | truck | gift | check | package
{% enddoc %}
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.5a4.3 4.3 0 0 1 7.5 2.3C19.5 15.4 12 20 12 20z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'gift' -%}
      <rect x="4" y="10" width="16" height="10"/><rect x="3" y="7" width="18" height="3"/><path d="M12 7v13M12 7c-1-3-5-3-4.5-.5C8 8 12 7 12 7zM12 7c1-3 5-3 4.5-.5C16 8 12 7 12 7z"/>
    {%- when 'package' -%}
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>
    {%- else -%}
      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>
  {%- endcase -%}
</svg>
