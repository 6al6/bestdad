{%- comment -%}
  Secondary link card under the buy button on the product page. Links to the other edition of the book
  (Slovenian book page -> English edition, English book page -> Slovenian edition).

  Params:
    handle   - handle of the product to link to (e.g. the-best-dad-book)
    market   - market handle the link is shown in (e.g. si). Blank = every market.
    title    - first line
    subtitle - second line, before the price (the price is read live from the linked product)
    note     - optional third line, e.g. a ship date

  Badge: "EN" when linking to the English book (the-best-dad-book), "SLO" for any other product.

  Hidden automatically when:
    - the linked product is not published to the current market (price and availability are market-specific)
    - the current market does not match `market`
    - the page already shows the linked product

  Price: formatted Slovenian-style (comma, no trailing ,00): 50,00 EUR shows as "50 €".

  Uses the colour and font variables of .landing-pp (--lpp-*), so it must be rendered inside landing-product-page.
{%- endcomment -%}
{%- liquid
  assign alt_product = all_products[handle]
  assign show_alt = false
  if alt_product.id and product.handle != handle
    assign show_alt = true
    if market != blank and localization.market.handle != market
      assign show_alt = false
    endif
  endif

  assign chip_label = 'EN'
  assign chip_lang = 'en'
  if handle != 'the-best-dad-book'
    assign chip_label = 'SLO'
    assign chip_lang = 'sl'
  endif

  if show_alt
    capture alt_price
      render 'money', amount: alt_product.price
    endcapture
    if localization.language.iso_code == 'sl'
      assign alt_price = alt_price | replace: '.', ','
    endif
    assign alt_price = alt_price | replace: ',00', ''
  endif
-%}

{%- if show_alt -%}
  <a class="landing-alt" href="{{ alt_product.url }}" data-event="{{ chip_lang }}-edition-link">
    <span class="landing-alt__chip" aria-hidden="true">{{ chip_label }}</span>
    <span class="landing-alt__copy">
      <span class="landing-alt__title">{{ title }}</span>
      <span class="landing-alt__sub"><span lang="{{ chip_lang }}">{{ subtitle }}</span> · {{ alt_price }}</span>
      {%- if note != blank -%}
        <span class="landing-alt__note">{{ note }}</span>
      {%- endif -%}
    </span>
    <svg class="landing-alt__arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
{%- endif -%}

{% style %}
  .landing-alt {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    margin-top: 6px;
    padding: 12px 16px;
    border: 1.5px solid color-mix(in srgb, var(--lpp-soft, #fef1d5) 55%, transparent);
    border-radius: 8px;
    color: var(--lpp-text, #fef1d5);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .landing-alt:hover {
    border-color: var(--lpp-soft, #fef1d5);
    background: color-mix(in srgb, var(--lpp-soft, #fef1d5) 8%, transparent);
  }
  .landing-alt:focus-visible {
    outline: 2px solid var(--lpp-soft, #fef1d5);
    outline-offset: 3px;
  }
  .landing-alt__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lpp-soft, #fef1d5);
    color: var(--lpp-bg, #2b2d45);
    font-family: var(--lpp-heading-font);
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .landing-alt__copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }
  .landing-alt__title {
    font-family: var(--lpp-heading-font);
    font-size: 20px;
    line-height: 1.1;
    overflow-wrap: break-word;
  }
  .landing-alt__sub { font-size: 15px; line-height: 1.3; opacity: 0.85; }
  .landing-alt__note { font-size: 13px; line-height: 1.3; opacity: 0.7; }
  .landing-alt__arrow { flex: none; width: 20px; height: 20px; transition: transform 0.15s ease; }
  .landing-alt:hover .landing-alt__arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .landing-alt, .landing-alt__arrow { transition: none; }
    .landing-alt:hover .landing-alt__arrow { transform: none; }
  }
{% endstyle %}
