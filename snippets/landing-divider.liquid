{% doc %}
  Wavy divider at the top and/or bottom of a landing section (same shapes and movement as the
  theme's shape dividers). Styles: assets/landing-shared.css

  Render it once, right after the section's closing </section> tag:
    {% render 'landing-divider' %}

  Reads these section settings (all optional):
    divider_top_color     Color of the section ABOVE. Fills the wave at the top edge. Empty = no top divider.
    divider_bottom_color  Color of the section BELOW. Fills the wave at the bottom edge. Empty = no bottom divider.
    divider_style         Value like waves-1-patterned_1200x20 (shape name, then viewBox width x height)
    divider_animate       Checkbox
{% enddoc %}
{%- liquid
  assign style_value = section.settings.divider_style | default: 'waves-1-patterned_1200x20'
  assign shape = style_value | split: '_' | first
  assign dimensions = style_value | split: '_' | last | split: 'x'
  assign width = dimensions[0] | plus: 0.0
  assign height = dimensions[1] | plus: 0.0
  assign ratio = height | divided_by: width | times: 100.0
  assign copies = 1
  if section.settings.divider_animate
    assign copies = 2
  endif
-%}

{%- for position in (1..2) -%}
  {%- liquid
    if position == 1
      assign edge = 'top'
      assign color = section.settings.divider_top_color
    else
      assign edge = 'bottom'
      assign color = section.settings.divider_bottom_color
    endif
  -%}
  {%- if color != blank -%}
    <div class="landing-divider landing-divider--{{ edge }}" aria-hidden="true">
      <div
        class="landing-divider__track{% if copies == 2 %} is-animated{% endif %}"
        style="padding-top: {{ ratio }}%;"
      >
        {%- for i in (1..copies) -%}
          <div class="landing-divider__copy">
