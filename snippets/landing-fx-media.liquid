{%- doc -%}
  Image inside a Landing FX shape (wavy cutout, scallop, arch, blob...) with an outline and a hard
  offset shadow, Shapes-style. Needs {% render 'landing-fx-defs' %} somewhere on the page.

  @param {object} image - Image object (a placeholder renders when blank)
  @param {string} shape - frame, wavy, scallop, circle, blob, arch, soft-burst, burst
  @param {string} ratio - CSS aspect-ratio, e.g. '4 / 5'
  @param {string} sizes - sizes attribute for the image
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [position] - object-position, e.g. '50% 30%'
{%- enddoc -%}
{%- liquid
  assign media_shape = shape | default: 'frame'
  assign media_loading = loading | default: 'lazy'
  assign media_priority = 'auto'
  if media_loading == 'eager'
    assign media_priority = 'high'
  endif
-%}
<div
  class="lfx-media lfx-media--{{ media_shape }}"
  style="--ratio: {{ ratio | default: '4 / 5' }};{% unless media_shape == 'frame' %} --clip: url(#lfx-clip-{{ media_shape }});{% endunless %}{% if position != blank %} --pos: {{ position }};{% endif %}"
>
  {%- unless media_shape == 'frame' -%}
    <div class="lfx-media__shadow" aria-hidden="true"></div>
    <div class="lfx-media__outline" aria-hidden="true"></div>
  {%- endunless -%}
  <div class="lfx-media__img">
    {%- if image != blank -%}
      {{-
        image
        | image_url: width: 2000
        | image_tag:
          loading: media_loading,
          fetchpriority: media_priority,
          widths: '400, 600, 800, 1000, 1300, 1600, 2000',
          sizes: sizes,
          alt: image.alt
      -}}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'lfx-media__placeholder' }}
    {%- endif -%}
  </div>
</div>
