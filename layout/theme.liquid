<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
        {%- if request.page_type == 'index' and localization.country.iso_code == 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- assign landing_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ landing_url }}">
      <script>window.location.replace({{ landing_url | json }} + window.location.search);</script>
    {%- endif -%}
        {%- if request.page_type == 'page' and page.handle == 'landing' and localization.country.iso_code != 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- comment -%}
        The Slovenian landing page is Slovenia-only. Anyone who is NOT in Slovenia
        (e.g. after picking USA or Spain in the country switcher, or arriving via
        ?country=XX) is sent to the English landing page /pages/dads instead.
        /pages/dads sends Slovenia back here, so the two can never loop.
      {%- endcomment -%}
      {%- assign dads_url = routes.root_url | append: '/pages/dads' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ dads_url }}">
      <script>window.location.replace({{ dads_url | json }} + window.location.search);</script>
    {%- endif -%}
        {%- if request.page_type == 'page' and template.suffix == 'landing_us_general_new' and localization.country.iso_code == 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- assign landing_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ landing_url }}">
      <script>window.location.replace({{ landing_url | json }} + window.location.search);</script>
    {%- endif -%}
        {%- if request.page_type == 'page' and template.suffix == 'landing_us_fx' and localization.country.iso_code == 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- assign landing_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ landing_url }}">
      <script>window.location.replace({{ landing_url | json }} + window.location.search);</script>
    {%- endif -%}
        {%- if request.page_type == 'page' and template.suffix == 'landing_us_sell' and localization.country.iso_code == 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- assign landing_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ landing_url }}">
      <script>window.location.replace({{ landing_url | json }} + window.location.search);</script>
    {%- endif -%}
        {%- if request.page_type == 'page' and template.suffix == 'landing_us_sell_b' and localization.country.iso_code == 'SI' and request.design_mode == false and request.visual_preview_mode == false -%}
      {%- assign landing_url = routes.root_url | append: '/pages/landing' | replace: '//', '/' -%}
      <meta http-equiv="refresh" content="0; url={{ landing_url }}">
      <script>window.location.replace({{ landing_url | json }} + window.location.search);</script>
    {%- endif -%}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- liquid
      assign main_font = settings.type_main_font
      assign main_font_bold = main_font | font_modify: 'weight', 'bold'
      assign heading_font = settings.type_heading_font
    -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: '32x32' }}"
      >
    {%- endif -%}

    {%- unless settings.type_header_font.system?
      and settings.type_body_font.system?
    -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      # SEO: brand suffix of the <title>. English pages get "Best Dad Book", other
      # languages keep the shop name. No suffix when the title already contains the
      # suffix or the shop name, compared without regard to letter case.
      assign seo_title_suffix = shop.name
      if request.locale.iso_code == 'en'
        assign seo_title_suffix = 'Best Dad Book'
      endif
      assign seo_title_lower = page_title | downcase
      assign seo_suffix_lower = seo_title_suffix | downcase
      assign seo_shop_lower = shop.name | downcase
      assign seo_show_suffix = true
      if seo_title_lower contains seo_suffix_lower or seo_title_lower contains seo_shop_lower
        assign seo_show_suffix = false
      endif
    -%}
    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- if seo_show_suffix %}
        &ndash; {{ seo_title_suffix -}}
      {%- endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%} SEO: internal search results stay out of Google. {%- endcomment -%}
    {%- if request.page_type == 'search' %}
      <meta name="robots" content="noindex">
    {%- endif %}

    {%- comment -%} SEO: product and book data for Google on the Slovenian landing page. {%- endcomment -%}
    {%- render 'seo-landing-book-data' %}

    {%- render 'meta-tags' -%}
{%- liquid
  assign site_name = shop.name
  if request.locale.iso_code == 'sl'
    assign site_name = 'Najboljši Fotr'
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site_name }}",
  "url": "{{ request.origin }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site_name }}",
  "url": "{{ request.origin }}",
  "logo": "https:{{ settings.favicon | image_url: width: 512 }}",
  "sameAs": [
    "https://www.facebook.com/bestdadbook",
    "https://www.instagram.com/bestdadbook",
    "https://www.tiktok.com/@bestdadbook",
    "https://www.youtube.com/@BestDadBook"
  ]
}
</script>

    {% comment %}
      This script tag contains options for es-modules-shim, which is loaded
      automatically by Shopify.
    {% endcomment %}
    <script type="esms-options">
      {
        "noLoadEventRetriggers": true
      }
    </script>

    <script type="importmap">
      {
        "imports": {
          "vendor": "{{ 'vendor.bundle.min.js' | asset_url }}",
          "deferrable-data": "{{ 'deferrable-data.bundle.js' | asset_url }}",
          "product": "{{ 'island-product.bundle.js' | asset_url }}",
          "product-model": "{{ 'island-product-model.bundle.js' | asset_url }}"
        }
      }
    </script>

    {{ content_for_header }}

    {{ 'base.bundle.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'custom-font.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'js-bridge' %}

    <script>
      document.documentElement.className =
        document.documentElement.className.replace('no-js', 'js');
    </script>

    <script>
      function debounce(fn, wait) {
        let t;
        return (...args) => {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(this, args), wait);
        };
      }
    </script>

    <script src="{{ 'utils.js' | asset_url }}" defer></script>

    {% if request.design_mode %}
      <script src="{{ 'shapes-animations.js' | asset_url }}" defer></script>
      <script
        src="{{ 'theme-editor-support.js' | asset_url }}"
        type="module"
      ></script>
    {% endif %}

    {% if template contains 'customers' %}
      {% comment %}theme-check-disable ParserBlockingScript{% endcomment %}
      {{ 'shopify_common.js' | shopify_asset_url | script_tag }}
      {{ 'customer_area.js' | shopify_asset_url | script_tag }}
      {% comment %}theme-check-enable ParserBlockingScript{% endcomment %}
    {% endif %}

    <script>
      window.themeEventsDebugMode = false;
    </script>
    <script src="{{ 'theme-events.js' | asset_url }}" async defer></script>

    <style>
      :root {
        --max-site-width: 1820px;
      }
    </style>

    {% style %}
      {{ main_font | font_face: font_display: 'swap' }}
      {%- unless heading_font.family contains 'Dela Gothic One' %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {%- endunless %}

      {%- liquid
        assign main_font_bolder = main_font | font_modify: 'weight', 'bolder'
        assign main_font_italic = main_font | font_modify: 'style', 'italic'
        assign main_font_bold_italic = main_font_bold | font_modify: 'style', 'italic'

        if main_font_bold
          echo main_font_bold | font_face: font_display: 'swap'
        endif
        if main_font_italic
          echo main_font_italic | font_face: font_display: 'swap'
        endif
        if main_font_bold_italic
          echo main_font_bold_italic | font_face: font_display: 'swap'
        endif
        if main_font_bolder
          echo main_font_bolder | font_face: font_display: 'swap'
        endif
      -%}

      {% if settings.heading_uppercase -%}
        {%- capture heading_capitalize -%}uppercase{%- endcapture -%}
      {% else -%}
        {%- capture heading_capitalize -%}none{%- endcapture -%}
      {% endif -%}
      {%- capture heading_letterspacing -%}{{ settings.heading_letterspacing | divided_by: 1000.0 }}{% unless settings.heading_letterspacing == 0 -%}em{% endunless -%}{%- endcapture -%}

      :root {
        --heading-font-stack: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --heading-font-weight: {{ heading_font.weight }};
        --heading-font-style: {{ heading_font.style }};
        --heading-letterspacing: {{ heading_letterspacing }};
        --heading-capitalize: {{ heading_capitalize }};
        --main-font-stack: {{ main_font.family }}, {{ main_font.fallback_families }};
        --main-font-weight: {{ main_font.weight }};
        --main-font-style: {{ main_font.style }};
      }
    {% endstyle %}

    {%- liquid
      render 'css-bridge'
      render 'critical-css'
    -%}

    <style id="manual-critical-css">
      [x-cloak] {
        display: none;
      }

      data-island {
        display: block;
      }

      [data-parallax-container] {
        will-change: opacity;
        opacity: 0;
        transition: opacity 0.2s cubic-bezier(0.215, 0.61, 0.355, 1);
      }
      .no-js [data-parallax-container],
      [data-parallax-container].animated {
        opacity: 1;
      }

      @media (prefers-reduced-motion) {
        [data-parallax-container] {
          opacity: 1;
        }
      }
    </style>

    {% # theme-check-disable AssetPreload %}
    {%- comment -%}
      Speed fix 18.10: Shopify's copy of Dela Gothic One is one 1.1 MB file (it carries thousands
      of Japanese glyphs) and it was preloaded on every page. Google Fonts serves the same font
      split by alphabet, so visitors only download the Latin part (~20 KB, incl. č š ž).
      Loaded without blocking the page; text shows at once and swaps when the font arrives.
      Any other heading font picked in theme settings still loads the normal way.
    {%- endcomment -%}
    {% if heading_font.family contains 'Dela Gothic One' %}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap"></noscript>
    {% else %}
      {% unless heading_font.system? %}
        <link
          rel="preload"
          as="font"
          href="{{ heading_font | font_url }}"
          type="font/woff2"
          crossorigin
        >
      {% endunless %}
    {% endif %}
    {% unless main_font.system? %}
      <link
        rel="preload"
        as="font"
        href="{{ main_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {% endunless %}
    {% # theme-check-enable AssetPreload %}
    {% render 'eur-price-fix' %}
  </head>

  <body data-color-scheme="scheme1">
    {%- if settings.show_on_sale_badge -%}
      {%- render 'static-sticker-defs',
        shape: settings.on_sale_badge_shape,
        id: 'on-sale'
      -%}
    {%- endif -%}
    {%- if settings.show_sold_out_badge -%}
      {%- render 'static-sticker-defs',
        shape: settings.sold_out_badge_shape,
        id: 'sold-out'
      -%}
    {%- endif -%}
    {%- render 'static-sticker-defs',
      shape: settings.metafield_badge_shape,
      id: 'metafield-badge'
    -%}

    <a class="skip-link" href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>
    {% if template.suffix == 'landing_m_v1' or template.suffix == 'landing_f_v1' or template.suffix == 'landing_g_v1' or template.suffix == 'landing_us_general_new' or template.suffix == 'landing_us_fx' or template.suffix == 'landing_us_sell' or template.suffix == 'landing_us_partners' or template.suffix == 'landing_us_grandma' or template.suffix == 'landing_us_sell_b' or template.suffix == 'landing_us_partners_b' or template.suffix == 'landing_us_grandma_b' %}
      {% sections 'header-group-landing' %}
    {% elsif template.suffix == 'landing' or template.suffix == 'legenda' or template.suffix == 'darilo-babice' or template.suffix == 'darilo-partnerke' or template.suffix == 'darilo-frend' %}
      {%- comment -%} SI landing pages: no site header, only the top bar from the landing header group. {%- endcomment -%}
      {% sections 'header-group-landing' %}
    {%- comment -%} New landing page: no site header. Its own "Landing: Header bar" section is used instead. {%- endcomment -%}
      {%- comment -%} New landing page: no site header. Its own "Landing: Header bar" section is used instead. {%- endcomment -%}
    {% elsif template.suffix == 'ugc-2' %}
      {% sections 'header-group-ugc' %}
    {% else %}
      {% sections 'header-group' %}
    {% endif %}


    {% render 'header-group-support' %}
    <main id="MainContent" class="overflow-hidden">
      {%- comment -%} Slovenian homepage lives in its own section group; other languages keep the index template {%- endcomment -%}
      {%- if template.name == 'index' and request.locale.iso_code == 'sl' -%}
        {%- sections 'home-sl' -%}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {%- sections 'footer-group' -%}
    {%- sections 'overlay-group' -%}

    <div
      id="screenreader-announce"
      class="sr-only"
      aria-live="polite"
      role="status"
    ></div>

    <ul hidden>
      <li id="a11y-refresh-page-message">
        {{ 'general.accessibility.refresh_page' | t }}
      </li>
      <li id="a11y-selection-message">
        {{ 'general.accessibility.selection_help' | t }}
      </li>
    </ul>

    {% comment %} Modal containers {% endcomment %}
    {% liquid
      render 'left-drawer'
      render 'right-drawer'
      render 'modal'
      render 'popup'
    %}

    {%- if settings.cart_type == 'modal' -%}
      {% render 'drawer-cart' %}
    {%- endif -%}

    <script src="{{ 'global.bundle.js' | asset_url }}" type="module"></script>

{% if template == 'page.landing_f_v1'
   or template == 'page.landing_g_v1'
   or template == 'page.landing_m_v1'
%}

<script>
document.addEventListener("DOMContentLoaded", function () {

  function isMobile() {
    return window.innerWidth <= 767;
  }

  if (!isMobile()) return;

  const originalBtn = document.querySelector(
    'a[href="#dad-book-product-anchor"][class*="ai-floating-button-"]'
  );

  if (!originalBtn) return;

  const anchor = document.getElementById("dad-book-product-anchor");
  const footerEl = document.querySelector("footer");

  const stickyWrapper = document.createElement("div");
  stickyWrapper.id = "sticky-buy-wrapper";
  stickyWrapper.style.cssText = `
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 12px;
    background: white;
    display: none;
    z-index: 999999999;
    box-shadow: 0 -5px 15px rgba(0,0,0,0.08);
    text-align: center;
    justify-content: center;
    align-items: center;
  `;

  const stickyBtn = originalBtn.cloneNode(true);
  stickyBtn.classList.add("sticky-buy-btn");
  stickyBtn.style.setProperty("visibility", "visible", "important");
  stickyBtn.style.setProperty("pointer-events", "auto", "important");

  stickyWrapper.appendChild(stickyBtn);
  document.body.appendChild(stickyWrapper);

  function isVisible(el) {
    if (!el) return false;
    const rect = el.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  function showSticky() {
    stickyWrapper.style.display = "flex";
    if (footerEl) footerEl.style.paddingBottom = "60px";
  }

  function hideSticky() {
    stickyWrapper.style.display = "none";
    if (footerEl) footerEl.style.paddingBottom = "";
  }

  function handleScroll() {
    if (!isMobile()) {
      hideSticky();
      return;
    }

    const originalRect = originalBtn.getBoundingClientRect();
    const anchorVisible = isVisible(anchor);

    if (originalRect.top < 0 && !anchorVisible) {
      showSticky();
    } else {
      hideSticky();
    }
  }

  window.addEventListener("scroll", handleScroll);
  window.addEventListener("resize", handleScroll);
});
</script>


{% endif %}


      {%- comment -%}
        18.10: the old "Landing FX: Buy bar" was rendered here for the partners and grandma pages,
        on top of the "Landing: Sticky button" in the footer group, so phones showed two bars.
        All landing and book product pages now use only the footer-group sticky button.
      {%- endcomment -%}

{%- comment -%} US test 20.10: add to cart goes straight to checkout (skips the cart drawer). Remove to undo. {%- endcomment -%}
{%- if false and localization.country.iso_code == 'US' -%}
<style>
  html.bdb-go [class*="upcart" i], html.bdb-go [id*="upcart" i] { visibility: hidden !important; }
  #bdb-go { position: fixed; inset: 0; z-index: 2147483647; display: none; align-items: center; justify-content: center; background: #fef1d5; color: #2b2d45; font: 700 18px/1.3 sans-serif; }
  html.bdb-go #bdb-go { display: flex; }
</style>
<div id="bdb-go">Taking you to checkout…</div>
<script>
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || !form.action || form.action.indexOf('/cart/add') === -1) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    document.documentElement.classList.add('bdb-go');
    fetch('/cart/add.js', { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } })
      .then(function (r) { if (!r.ok) throw r; window.location.href = '/checkout'; })
      .catch(function () { document.documentElement.classList.remove('bdb-go'); form.submit(); });
  }, true);
  window.addEventListener('pageshow', function () { document.documentElement.classList.remove('bdb-go'); });
</script>
{%- endif -%}

</body>
</html>

