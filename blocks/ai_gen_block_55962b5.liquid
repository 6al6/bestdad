{% doc %}
  @prompt
    Create a custom Shopify section with a single block that works as a fully customizable floating review badge. The badge shape is a rounded rectangle with a raised top tab for the stars: the main body is a pill-style rounded rectangle, and at its top center there is a slightly elevated bump that smoothly blends into the body so it feels like one continuous shape. The stars sit inside this bump so the top area looks visually lifted above the rest of the badge. The block must provide full WYSIWYG rich-text control for the copy (bold, italic, underline, line breaks, font-size changes, multiple lines). All colors must be editable, including background, text, star color, and shadow color. The badge needs separate desktop and mobile settings for all key layout values: X position, Y position, width, height, padding, font size, star size, alignment, and spacing. The block must support free positioning using numeric controls for top and left (accepting px, %, vw, or vh) plus width and height inputs. It must include an adjustable z-index so the badge can overlay every other block in the section, and it should default to a high z-index. Add a toggle to switch between absolute, fixed, and relative positioning, with absolute as the default. The badge must have editable border-radius settings for both the main body corners and the raised tab corners so the designer can match a soft, smooth look. Include options for box-shadow strength, opacity, optional background gradient, and a custom CSS text area with support for different rules on desktop and mobile. Add an image picker for the star graphic (PNG or SVG), with independent desktop and mobile size controls and a setting for spacing between stars. Inside the badge layout, place the stars inside the raised tab at the top, and position the rich-text block below them, with controls for horizontal alignment (left/center/right) and vertical spacing so the text and stars together can be fine-tuned
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-floating-badge-{{ ai_gen_id }} {
    position: {{ block.settings.position_type }};
    z-index: {{ block.settings.z_index }};
    display: flex;
    flex-direction: column;
    align-items: center;
    width: {{ block.settings.badge_width_mobile }};
    {% if block.settings.enable_gradient %}
      background: linear-gradient(135deg, {{ block.settings.background_color }}, {{ block.settings.gradient_color }});
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
    border-radius: {{ block.settings.body_border_radius }}px;
    padding: {{ block.settings.padding_mobile }};
    box-shadow: 0 {{ block.settings.shadow_strength }}px {{ block.settings.shadow_strength | times: 2 }}px rgba({{ block.settings.shadow_color | color_extract: 'red' }}, {{ block.settings.shadow_color | color_extract: 'green' }}, {{ block.settings.shadow_color | color_extract: 'blue' }}, {{ block.settings.shadow_opacity }});
    top: {{ block.settings.y_position_mobile }};
    left: {{ block.settings.x_position_mobile }};
    height: {{ block.settings.badge_height_mobile }};
  }

  .ai-floating-badge-tab-{{ ai_gen_id }} {
    position: relative;
    top: calc(-{{ block.settings.padding_mobile }} - {{ block.settings.tab_height_mobile }});
    margin-bottom: calc(-{{ block.settings.tab_height_mobile }});
    background-color: {{ block.settings.tab_background_color }};
    border-radius: {{ block.settings.tab_border_radius }}px {{ block.settings.tab_border_radius }}px 0 0;
    padding: {{ block.settings.tab_padding_mobile }};
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.star_spacing_mobile }};
    min-height: {{ block.settings.tab_height_mobile }};
  }

  .ai-floating-badge-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size_mobile }};
    height: {{ block.settings.star_size_mobile }};
    object-fit: contain;
  }

  .ai-floating-badge-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size_mobile }};
    text-align: {{ block.settings.text_alignment }};
    margin-top: {{ block.settings.vertical_spacing_mobile }};
    width: 100%;
  }

  .ai-floating-badge-content-{{ ai_gen_id }} p {
    margin: 0;
  }

  {% if block.settings.custom_css_mobile != blank %}
    {{ block.settings.custom_css_mobile }}
  {% endif %}

  @media screen and (min-width: 750px) {
    .ai-floating-badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_width_desktop }};
      padding: {{ block.settings.padding_desktop }};
      top: {{ block.settings.y_position_desktop }};
      left: {{ block.settings.x_position_desktop }};
      height: {{ block.settings.badge_height_desktop }};
    }

    .ai-floating-badge-tab-{{ ai_gen_id }} {
      top: calc(-{{ block.settings.padding_desktop }} - {{ block.settings.tab_height_desktop }});
      margin-bottom: calc(-{{ block.settings.tab_height_desktop }});
      padding: {{ block.settings.tab_padding_desktop }};
      gap: {{ block.settings.star_spacing_desktop }};
      min-height: {{ block.settings.tab_height_desktop }};
    }

    .ai-floating-badge-star-{{ ai_gen_id }} {
      width: {{ block.settings.star_size_desktop }};
      height: {{ block.settings.star_size_desktop }};
    }

    .ai-floating-badge-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_desktop }};
      margin-top: {{ block.settings.vertical_spacing_desktop }};
    }

    {% if block.settings.custom_css_desktop != blank %}
      {{ block.settings.custom_css_desktop }}
    {% endif %}
  }
{% endstyle %}

<div class="ai-floating-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-floating-badge-tab-{{ ai_gen_id }}">
    {% if block.settings.star_image %}
      {% for i in (1..block.settings.star_count) %}
        <img
          src="{{ block.settings.star_image | image_url: width: 100 }}"
          alt="Star {{ i }}"
          class="ai-floating-badge-star-{{ ai_gen_id }}"
          loading="lazy"
        >
      {% endfor %}
    {% else %}
      {% for i in (1..block.settings.star_count) %}
        <svg class="ai-floating-badge-star-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="{{ block.settings.star_color }}" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
        </svg>
      {% endfor %}
    {% endif %}
  </div>

  <div class="ai-floating-badge-content-{{ ai_gen_id }}">
    {{ block.settings.badge_text }}
  </div>
</div>

