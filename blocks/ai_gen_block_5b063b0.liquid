      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Shadow blur",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_shadow_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Shadow opacity",
      "default": 0.3
    },
    {
      "type": "checkbox",
      "id": "mobile_enable_parallax",
