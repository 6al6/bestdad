{% doc %}
  @prompt
    I need a section which has:
    - All the functions/options seperate for mobile and desktop
    - Has the same font family for body and headlines as the whole theme
    - Has the option to change the font size, type, color, etc.
    
    The section should have a full width picture, for which you can change the height. The picture has a text box overlayed, for which you can choose whether it is high up or down low - you choose the position of the text by choice. It overlays the picture. The text follows the theme s font and settings., The image can be different for the movile and desktop version.
    The heading and body text can be jsut one rich text entry field, where there are options to format., Add the options for the text content whether it is centrally, left or right aligned. Add a slider for the text position height., Also add in the option to choose how wide the text box is. as well as the option to choose whether the text box color is transparent (no color)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  .ai-hero-text-overlay-{{ ai_gen_id }} {
    max-width: 640px;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.mobile_image_height }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.desktop_image_height }}px;
    }
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    padding: {{ block.settings.mobile_text_padding }}px;
    width: {{ block.settings.mobile_text_box_width }}%;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-text-overlay-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_text_padding }}px;
      width: {{ block.settings.desktop_text_box_width }}%;
    }
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-top-left {
    top: {{ block.settings.mobile_vertical_position }}%;
    left: 20px;
    transform: translateY(-50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-top-center {
    top: {{ block.settings.mobile_vertical_position }}%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-top-right {
    top: {{ block.settings.mobile_vertical_position }}%;
    right: 20px;
    transform: translateY(-50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-center-left {
    top: 50%;
    left: 20px;
    transform: translateY(-50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-center-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-center-right {
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-bottom-left {
    bottom: calc(100% - {{ block.settings.mobile_vertical_position }}%);
    left: 20px;
    transform: translateY(50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-bottom-center {
    bottom: calc(100% - {{ block.settings.mobile_vertical_position }}%);
    left: 50%;
    transform: translate(-50%, 50%);
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--mobile-bottom-right {
    bottom: calc(100% - {{ block.settings.mobile_vertical_position }}%);
    right: 20px;
    transform: translateY(50%);
  }

  @media screen and (min-width: 750px) {
    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-top-left {
      top: {{ block.settings.desktop_vertical_position }}%;
      left: 40px;
      bottom: auto;
      right: auto;
      transform: translateY(-50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-top-center {
      top: {{ block.settings.desktop_vertical_position }}%;
      left: 50%;
      bottom: auto;
      right: auto;
      transform: translate(-50%, -50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-top-right {
      top: {{ block.settings.desktop_vertical_position }}%;
      right: 40px;
      bottom: auto;
      left: auto;
      transform: translateY(-50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-center-left {
      top: 50%;
      left: 40px;
      bottom: auto;
      right: auto;
      transform: translateY(-50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-center-center {
      top: 50%;
      left: 50%;
      bottom: auto;
      right: auto;
      transform: translate(-50%, -50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-center-right {
      top: 50%;
      right: 40px;
      bottom: auto;
      left: auto;
      transform: translateY(-50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-bottom-left {
      bottom: calc(100% - {{ block.settings.desktop_vertical_position }}%);
      left: 40px;
      top: auto;
      right: auto;
      transform: translateY(50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-bottom-center {
      bottom: calc(100% - {{ block.settings.desktop_vertical_position }}%);
      left: 50%;
      top: auto;
      right: auto;
      transform: translate(-50%, 50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--desktop-bottom-right {
      bottom: calc(100% - {{ block.settings.desktop_vertical_position }}%);
      right: 40px;
      top: auto;
      left: auto;
      transform: translateY(50%);
    }
  }

  .ai-hero-text-content-{{ ai_gen_id }} {
    {% if block.settings.enable_text_background %}
      background-color: {{ block.settings.text_background_color }};
    {% else %}
      background-color: transparent;
    {% endif %}
    padding: {{ block.settings.mobile_text_box_padding }}px;
    border-radius: {{ block.settings.text_box_border_radius }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-text-content-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_text_box_padding }}px;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-hero-richtext-{{ ai_gen_id }}--mobile-left {
    text-align: left;
  }

  .ai-hero-richtext-{{ ai_gen_id }}--mobile-center {
    text-align: center;
  }

  .ai-hero-richtext-{{ ai_gen_id }}--mobile-right {
    text-align: right;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }}--desktop-left {
      text-align: left;
    }

    .ai-hero-richtext-{{ ai_gen_id }}--desktop-center {
      text-align: center;
    }

    .ai-hero-richtext-{{ ai_gen_id }}--desktop-right {
      text-align: right;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} h1,
  .ai-hero-richtext-{{ ai_gen_id }} h2,
  .ai-hero-richtext-{{ ai_gen_id }} h3,
  .ai-hero-richtext-{{ ai_gen_id }} h4,
  .ai-hero-richtext-{{ ai_gen_id }} h5,
  .ai-hero-richtext-{{ ai_gen_id }} h6 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    margin: 0 0 {{ block.settings.mobile_heading_spacing }}px 0;
    {% if block.settings.heading_text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.heading_text_transform == 'lowercase' %}
      text-transform: lowercase;
    {% elsif block.settings.heading_text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }} h1,
    .ai-hero-richtext-{{ ai_gen_id }} h2,
    .ai-hero-richtext-{{ ai_gen_id }} h3,
    .ai-hero-richtext-{{ ai_gen_id }} h4,
    .ai-hero-richtext-{{ ai_gen_id }} h5,
    .ai-hero-richtext-{{ ai_gen_id }} h6 {
      margin: 0 0 {{ block.settings.desktop_heading_spacing }}px 0;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} h1 {
    font-size: {{ block.settings.mobile_h1_size }}px;
  }

  .ai-hero-richtext-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.mobile_h2_size }}px;
  }

  .ai-hero-richtext-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.mobile_h3_size }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }} h1 {
      font-size: {{ block.settings.desktop_h1_size }}px;
    }

    .ai-hero-richtext-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.desktop_h2_size }}px;
    }

    .ai-hero-richtext-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.desktop_h3_size }}px;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} p {
    font-size: {{ block.settings.mobile_body_size }}px;
    margin: 0 0 {{ block.settings.mobile_paragraph_spacing }}px 0;
    {% if block.settings.body_text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.body_text_transform == 'lowercase' %}
      text-transform: lowercase;
    {% elsif block.settings.body_text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% endif %}
  }

  .ai-hero-richtext-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }} p {
      font-size: {{ block.settings.desktop_body_size }}px;
      margin: 0 0 {{ block.settings.desktop_paragraph_spacing }}px 0;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-hero-richtext-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-hero-richtext-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-hero-richtext-{{ ai_gen_id }} ul,
  .ai-hero-richtext-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.mobile_paragraph_spacing }}px 0;
    padding-left: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }} ul,
    .ai-hero-richtext-{{ ai_gen_id }} ol {
      margin: 0 0 {{ block.settings.desktop_paragraph_spacing }}px 0;
    }
  }

  .ai-hero-richtext-{{ ai_gen_id }} li {
    font-size: {{ block.settings.mobile_body_size }}px;
    margin-bottom: 8px;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-richtext-{{ ai_gen_id }} li {
      font-size: {{ block.settings.desktop_body_size }}px;
    }
  }

  .ai-floating-badge-{{ ai_gen_id }} {
    z-index: 10;
    pointer-events: auto;
    display: inline-block;
    max-width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-floating-badge-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_badge_width }}px;
      margin-bottom: {{ block.settings.desktop_badge_margin_bottom }}px;
    }

    .ai-floating-badge-inner-{{ ai_gen_id }} {
      background: {{ block.settings.desktop_badge_background }};
      padding: {{ block.settings.desktop_badge_padding }}px;
      border-radius: {{ block.settings.desktop_badge_corner_radius }}px;
    }

    .ai-floating-badge-text-{{ ai_gen_id }} {
      color: {{ block.settings.desktop_badge_text_color }};
      font-size: {{ block.settings.desktop_badge_text_size }}px;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-floating-badge-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_badge_width }}px;
      margin-bottom: {{ block.settings.mobile_badge_margin_bottom }}px;
    }

    .ai-floating-badge-inner-{{ ai_gen_id }} {
      background: {{ block.settings.mobile_badge_background }};
      padding: {{ block.settings.mobile_badge_padding }}px;
      border-radius: {{ block.settings.mobile_badge_corner_radius }}px;
    }

    .ai-floating-badge-text-{{ ai_gen_id }} {
      color: {{ block.settings.mobile_badge_text_color }};
      font-size: {{ block.settings.mobile_badge_text_size }}px;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
  }

  .ai-floating-badge-text-{{ ai_gen_id }} * {
    margin: 0;
    padding: 0;
  }

  .ai-floating-badge-text-{{ ai_gen_id }} p {
    margin-bottom: 0.5em;
  }

  .ai-floating-badge-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-sticker-container-{{ ai_gen_id }} {
    position: absolute;
    pointer-events: none;
    z-index: 999;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

  .ai-sticker-image-{{ ai_gen_id }} {
    position: absolute;
    pointer-events: auto;
    transition: transform 0.1s ease-out;
  }

  @media screen and (min-width: 750px) {
    .ai-sticker-image-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_scale }}%;
      top: {{ block.settings.desktop_y }}%;
      left: {{ block.settings.desktop_x }}%;
      transform: translate(-50%, -50%);
      {% if block.settings.desktop_enable_shadow %}
        filter: drop-shadow({{ block.settings.desktop_shadow_x }}px {{ block.settings.desktop_shadow_y }}px {{ block.settings.desktop_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.desktop_shadow_opacity }}));
      {% endif %}
    }
  }

  @media screen and (max-width: 749px) {
    .ai-sticker-image-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_scale }}%;
      top: {{ block.settings.mobile_y }}%;
      left: {{ block.settings.mobile_x }}%;
      transform: translate(-50%, -50%);
      {% if block.settings.mobile_enable_shadow %}
        filter: drop-shadow({{ block.settings.mobile_shadow_x }}px {{ block.settings.mobile_shadow_y }}px {{ block.settings.mobile_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.mobile_shadow_opacity }}));
      {% endif %}
    }
  }

  .ai-sticker-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }
{% endstyle %}

<div class="ai-hero-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.mobile_image or block.settings.desktop_image %}
      <picture>
        {% if block.settings.desktop_image %}
          <source
            media="(min-width: 750px)"
            srcset="{{ block.settings.desktop_image | image_url: width: 2500 }}"
          >
        {% endif %}
        {% if block.settings.mobile_image %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.mobile_image | image_url: width: 1500 }}"
          >
        {% endif %}
        <img
          src="{{ block.settings.desktop_image | default: block.settings.mobile_image | image_url: width: 1500 }}"
          alt="{{ block.settings.desktop_image.alt | default: block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          class="ai-hero-responsive-image-{{ ai_gen_id }}"
        >
      </picture>
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-empty-state-{{ ai_gen_id }}">
          Add images to get started
        </div>
      </div>
    {% endif %}

    {% if block.settings.text_content != blank %}
      <div class="ai-hero-text-overlay-{{ ai_gen_id }} ai-hero-text-overlay-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_text_position }} ai-hero-text-overlay-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_text_position }}">
        {% if block.settings.badge_text != blank %}
          <div class="ai-floating-badge-{{ ai_gen_id }}">
            <div class="ai-floating-badge-inner-{{ ai_gen_id }}">
              <div class="ai-floating-badge-text-{{ ai_gen_id }}">
                {{ block.settings.badge_text }}
              </div>
            </div>
          </div>
        {% endif %}

        <div class="ai-hero-text-content-{{ ai_gen_id }}">
          <sticker-block-{{ ai_gen_id }}
            class="ai-sticker-container-{{ ai_gen_id }}"
            data-desktop-parallax="{{ block.settings.desktop_enable_parallax }}"
            data-mobile-parallax="{{ block.settings.mobile_enable_parallax }}"
            data-desktop-intensity="{{ block.settings.desktop_parallax_intensity }}"
            data-mobile-intensity="{{ block.settings.mobile_parallax_intensity }}"
          >
            <div class="ai-sticker-image-{{ ai_gen_id }}">
              {% if block.settings.sticker_desktop_image != blank %}
                <img
                  src="{{ block.settings.sticker_desktop_image | image_url: width: 800 }}"
                  alt="{{ block.settings.sticker_desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.sticker_desktop_image.width }}"
                  height="{{ block.settings.sticker_desktop_image.height }}"
                  class="ai-sticker-desktop-{{ ai_gen_id }}"
                  style="display: none;"
                >
              {% endif %}
              {% if block.settings.sticker_mobile_image != blank %}
                <img
                  src="{{ block.settings.sticker_mobile_image | image_url: width: 600 }}"
                  alt="{{ block.settings.sticker_mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.sticker_mobile_image.width }}"
                  height="{{ block.settings.sticker_mobile_image.height }}"
                  class="ai-sticker-mobile-{{ ai_gen_id }}"
                  style="display: none;"
                >
              {% endif %}
            </div>
          </sticker-block-{{ ai_gen_id }}>

          <div class="ai-hero-richtext-{{ ai_gen_id }} ai-hero-richtext-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_text_align }} ai-hero-richtext-{{ ai_gen_id }}--desktop-{{ block.settings.desktop_text_align }}">
            {{ block.settings.text_content }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    class StickerBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.desktopParallax = this.dataset.desktopParallax === 'true';
        this.mobileParallax = this.dataset.mobileParallax === 'true';
        this.desktopIntensity = parseFloat(this.dataset.desktopIntensity) / 100;
        this.mobileIntensity = parseFloat(this.dataset.mobileIntensity) / 100;
        this.stickerImage = this.querySelector('.ai-sticker-image-{{ ai_gen_id }}');
        this.isMobile = window.innerWidth < 750;
        this.handleScroll = this.handleScroll.bind(this);
        this.handleResize = this.handleResize.bind(this);
      }

      connectedCallback() {
        this.updateImageVisibility();
        
        if ((this.isMobile && this.mobileParallax) || (!this.isMobile && this.desktopParallax)) {
          window.addEventListener('scroll', this.handleScroll, { passive: true });
        }
        
        window.addEventListener('resize', this.handleResize);
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
        window.removeEventListener('resize', this.handleResize);
      }

      updateImageVisibility() {
        const desktopImg = this.querySelector('.ai-sticker-desktop-{{ ai_gen_id }}');
        const mobileImg = this.querySelector('.ai-sticker-mobile-{{ ai_gen_id }}');
        
        if (this.isMobile) {
          if (mobileImg) {
            mobileImg.style.display = 'block';
          }
          if (desktopImg) {
            desktopImg.style.display = 'none';
          }
        } else {
          if (desktopImg) {
            desktopImg.style.display = 'block';
          }
          if (mobileImg) {
            mobileImg.style.display = 'none';
          }
        }
      }

      handleResize() {
        const wasMobile = this.isMobile;
        this.isMobile = window.innerWidth < 750;
        
        if (wasMobile !== this.isMobile) {
          this.updateImageVisibility();
          
          window.removeEventListener('scroll', this.handleScroll);
          
          if ((this.isMobile && this.mobileParallax) || (!this.isMobile && this.desktopParallax)) {
            window.addEventListener('scroll', this.handleScroll, { passive: true });
          } else {
            this.stickerImage.style.transform = '';
          }
        }
      }

      handleScroll() {
        if (!this.stickerImage) return;

        const shouldParallax = (this.isMobile && this.mobileParallax) || (!this.isMobile && this.desktopParallax);
        
        if (!shouldParallax) return;

        const intensity = this.isMobile ? this.mobileIntensity : this.desktopIntensity;
        const rect = this.getBoundingClientRect();
        const scrolled = window.pageYOffset || document.documentElement.scrollTop;
        const elementTop = rect.top + scrolled;
        const elementHeight = rect.height;
        const windowHeight = window.innerHeight;
        
        const scrollProgress = (scrolled + windowHeight - elementTop) / (windowHeight + elementHeight);
        
        if (scrollProgress >= 0 && scrollProgress <= 1) {
          const movement = (scrollProgress - 0.5) * 100 * intensity;
          this.stickerImage.style.transform = `translate(-50%, calc(-50% + ${movement}px))`;
        }
      }
    }

    customElements.define('sticker-block-{{ ai_gen_id }}', StickerBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hero image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 400
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "richtext",
