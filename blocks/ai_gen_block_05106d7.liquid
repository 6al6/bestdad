{% doc %}
  @prompt
    Create a custom Shopify section containing a single block that functions as a fully customizable floating badge. The badge has a rounded rectangle base with a raised top tab that holds a row of stars. Give the user full WYSIWYG rich-text controls (bold, italic, underline, font size, line breaks, multi-line text). All colors must be editable, including background, text, and star colors. Use Shopify’s default shape and border-radius options, simply ensure the block supports changing shape. Include separate desktop and mobile settings for all key values: font size, padding, width, alignment, spacing, and overall badge positioning. The badge must support free positioning using top/left controls so it can float anywhere. Include adjustable z-index so it overlays other blocks. Provide an image picker for the star graphic (PNG or SVG) with separate star sizes for desktop and mobile. Add a vertical star offset control that moves the stars up or down inside the badge, and the raised top tab must automatically follow this movement so the shape stays visually correct. When the stars shift vertically, the raised top bump shifts with them as one combined element. Place the text below the stars, with spacing controls between them. Add options for shadows, opacity, optional gradients, and a custom CSS input for advanced styling on both desktop and mobile., Create a custom Shopify section containing a single block that functions as a fully customizable floating badge. The badge has a rounded rectangle base with a raised top tab that holds a row of stars. Give the user full WYSIWYG rich-text controls (bold, italic, underline, font size, line breaks, multi-line text). All colors must be editable, including background, text, and star colors. Use Shopify’s default shape and border-radius settings. Include separate desktop and mobile settings for all key values: font size, padding, width, alignment, spacing, and overall badge positioning. The badge must support position: absolute only (no sticky, no fixed), so the user can place it freely anywhere above other content using editable top/left controls. Provide an adjustable z-index so it overlays other blocks. Add an image picker for the star graphic (PNG or SVG) with separate star sizes for desktop and mobile. Include a vertical star offset control that moves the stars up or down inside the badge, and the raised top tab must automatically follow this movement. The stars and tab always shift together as one shape. The text sits below the stars with spacing controls. Add optional controls for shadows, opacity, gradients, and a custom CSS field for advanced adjustments. The block must never become sticky or fixed under any circumstances.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-floating-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.position_top_desktop }}px;
    left: {{ block.settings.position_left_desktop }}px;
    z-index: {{ block.settings.z_index }};
    width: {{ block.settings.badge_width_desktop }}px;
    opacity: {{ block.settings.opacity }};
    pointer-events: none;
  }

  .ai-floating-badge-container-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment_desktop }};
  }

  .ai-floating-badge-tab-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: {{ block.settings.tab_padding_desktop }}px;
    background: {{ block.settings.tab_background_color }};
    {% if block.settings.enable_gradient %}
      background: linear-gradient(135deg, {{ block.settings.tab_background_color }} 0%, {{ block.settings.gradient_color }} 100%);
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px 0 0;
    {% if block.settings.enable_shadow %}
      box-shadow: 0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    transform: translateY({{ block.settings.star_vertical_offset }}px);
  }

  .ai-floating-badge-stars-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.star_spacing_desktop }}px;
  }

  .ai-floating-badge-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size_desktop }}px;
    height: {{ block.settings.star_size_desktop }}px;
    object-fit: contain;
  }

  .ai-floating-badge-star-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.star_color }};
  }

  .ai-floating-badge-body-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.body_padding_desktop }}px;
    background: {{ block.settings.body_background_color }};
    {% if block.settings.enable_gradient %}
      background: linear-gradient(135deg, {{ block.settings.body_background_color }} 0%, {{ block.settings.gradient_color }} 100%);
    {% endif %}
    border-radius: 0 0 {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px;
    {% if block.settings.enable_shadow %}
      box-shadow: 0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    margin-top: {{ block.settings.star_vertical_offset }}px;
  }

  .ai-floating-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size_desktop }}px;
    text-align: center;
    line-height: 1.4;
  }

  .ai-floating-badge-text-{{ ai_gen_id }} * {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .ai-floating-badge-{{ ai_gen_id }} {
      top: {{ block.settings.position_top_mobile }}px;
      left: {{ block.settings.position_left_mobile }}px;
      width: {{ block.settings.badge_width_mobile }}px;
    }

    .ai-floating-badge-container-{{ ai_gen_id }} {
      align-items: {{ block.settings.alignment_mobile }};
    }

    .ai-floating-badge-tab-{{ ai_gen_id }} {
      padding: {{ block.settings.tab_padding_mobile }}px;
    }

    .ai-floating-badge-stars-{{ ai_gen_id }} {
      gap: {{ block.settings.star_spacing_mobile }}px;
    }

    .ai-floating-badge-star-{{ ai_gen_id }} {
      width: {{ block.settings.star_size_mobile }}px;
      height: {{ block.settings.star_size_mobile }}px;
    }

    .ai-floating-badge-body-{{ ai_gen_id }} {
      padding: {{ block.settings.body_padding_mobile }}px;
    }

    .ai-floating-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<div class="ai-floating-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-floating-badge-container-{{ ai_gen_id }}">
    <div class="ai-floating-badge-tab-{{ ai_gen_id }}">
      <div class="ai-floating-badge-stars-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          <div class="ai-floating-badge-star-{{ ai_gen_id }}">
            {% if block.settings.star_image %}
              <img
                src="{{ block.settings.star_image | image_url: width: 100 }}"
                alt="Star"
                loading="lazy"
                width="100"
                height="100"
              >
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-floating-badge-body-{{ ai_gen_id }}">
      <div class="ai-floating-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
