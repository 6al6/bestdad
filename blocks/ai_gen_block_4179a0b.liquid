{% doc %}
  @prompt
    Create a segment, which can be enabled to be mobile only or hidden on desktop.
    It has three images, all three in aspect ratio 21:9 one below eachother. The upload option for image is seperate for mobile and desktop. Optionally, you can set a gap of 0-50px between each image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-stack-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-image-stack-item-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .ai-image-stack-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-stack-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-stack-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 150px;
  }

  @media screen and (min-width: 750px) {
    .ai-image-stack-desktop-{{ ai_gen_id }} {
      display: block;
    }

    .ai-image-stack-mobile-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-image-stack-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-stack-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<div class="ai-image-stack-{{ ai_gen_id }}
  {% unless block.settings.show_desktop %} visibility-hide-desktop{% endunless %}
  {% unless block.settings.show_mobile %} visibility-hide-mobile{% endunless %}
" {{ block.shopify_attributes }}>
  {% for i in (1..3) %}
    {% liquid
      assign desktop_image_key = 'image_' | append: i | append: '_desktop'
      assign mobile_image_key = 'image_' | append: i | append: '_mobile'
      assign desktop_image = block.settings[desktop_image_key]
      assign mobile_image = block.settings[mobile_image_key]
    %}

    <div class="ai-image-stack-item-{{ ai_gen_id }}">
      <div class="ai-image-stack-desktop-{{ ai_gen_id }}">
        {% if desktop_image %}
          <img
            src="{{ desktop_image | image_url: width: 2000 }}"
            alt="{{ desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
          >
        {% else %}
          <div class="ai-image-stack-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-image-stack-mobile-{{ ai_gen_id }}">
        {% if mobile_image %}
          <img
            src="{{ mobile_image | image_url: width: 1000 }}"
            alt="{{ mobile_image.alt | escape }}"
            loading="lazy"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {% else %}
          <div class="ai-image-stack-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Image stack 21:9",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap between images",
      "default": 10
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_1_mobile",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_2_mobile",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_3_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_3_mobile",
      "label": "Mobile image"
    }
  ],
  "presets": [
    {
      "name": "Image stack 21:9"
    }
  ]
}
{% endschema %}
