{% doc %}
  @prompt
    Create a segment that has a hero image, a seper, and in the top third of the image there's an overlaying text, a heading text. This text needs to be movable up and down, but it's always at the center. Only the formatting can change, either left, center, or right formatting. The text take on theme CSS settings (font etc.). It can be very high up. No background. Options for line break sizes.
    
    Then the image can also have another an overlayed uploaded image at the bottom which only has sizing options. Add seperate options for mobile and desktop, Seperate images for mobile and desktop as well, ALl of the heading sizes, h1, h2, h3,h4, h5 should inherit theme font.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-hero-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    right: 0;
    top: {{ block.settings.text_vertical_position_desktop }}%;
    transform: translateY(-50%);
    z-index: 2;
    padding: 0 20px;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    line-height: {{ block.settings.line_height }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-weight: {{ settings.type_heading_font.weight }};
    font-style: {{ settings.type_heading_font.style }};
  }

  .ai-hero-heading-{{ ai_gen_id }}.h1 {
    font-size: calc(var(--font-heading-scale) * 2.5rem);
  }

  .ai-hero-heading-{{ ai_gen_id }}.h2 {
    font-size: calc(var(--font-heading-scale) * 2rem);
  }

  .ai-hero-heading-{{ ai_gen_id }}.h3 {
    font-size: calc(var(--font-heading-scale) * 1.75rem);
  }

  .ai-hero-heading-{{ ai_gen_id }}.h4 {
    font-size: calc(var(--font-heading-scale) * 1.5rem);
  }

  .ai-hero-heading-{{ ai_gen_id }}.h5 {
    font-size: calc(var(--font-heading-scale) * 1.25rem);
  }

  .ai-hero-overlay-image-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    max-width: 100%;
  }

  .ai-hero-overlay-image-{{ ai_gen_id }} img {
    display: block;
    width: {{ block.settings.overlay_image_width_desktop }}px;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-text-overlay-{{ ai_gen_id }} {
      top: {{ block.settings.text_vertical_position_mobile }}%;
    }

    .ai-hero-heading-{{ ai_gen_id }}.h1 {
      font-size: calc(var(--font-heading-scale) * 2rem);
    }

    .ai-hero-heading-{{ ai_gen_id }}.h2 {
      font-size: calc(var(--font-heading-scale) * 1.75rem);
    }

    .ai-hero-heading-{{ ai_gen_id }}.h3 {
      font-size: calc(var(--font-heading-scale) * 1.5rem);
    }

    .ai-hero-heading-{{ ai_gen_id }}.h4 {
      font-size: calc(var(--font-heading-scale) * 1.25rem);
    }

    .ai-hero-heading-{{ ai_gen_id }}.h5 {
      font-size: calc(var(--font-heading-scale) * 1.1rem);
    }

    .ai-hero-overlay-image-{{ ai_gen_id }} img {
      width: {{ block.settings.overlay_image_width_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-container-{{ ai_gen_id }}
  {% unless block.settings.show_desktop %} visibility-hide-desktop{% endunless %}
  {% unless block.settings.show_mobile %} visibility-hide-mobile{% endunless %}
" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.hero_image_desktop %}
      <picture>
        {% if block.settings.hero_image_mobile %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.hero_image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.hero_image_mobile | image_url: width: 1500 }} 1500w"
          >
        {% endif %}
        <img
          src="{{ block.settings.hero_image_desktop | image_url: width: 1500 }}"
          srcset="{{ block.settings.hero_image_desktop | image_url: width: 1500 }} 1500w,
                  {{ block.settings.hero_image_desktop | image_url: width: 3000 }} 3000w"
          alt="{{ block.settings.hero_image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.hero_image_desktop.width }}"
          height="{{ block.settings.hero_image_desktop.height }}"
          class="ai-hero-image-{{ ai_gen_id }}"
        >
      </picture>
    {% else %}
      <div class="ai-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-empty-state-{{ ai_gen_id }}">
          Add a hero image to get started
        </div>
      </div>
    {% endif %}

    {% if block.settings.heading_text != blank %}
      <div class="ai-hero-text-overlay-{{ ai_gen_id }}">
        <{{ block.settings.heading_tag }} class="ai-hero-heading-{{ ai_gen_id }} {{ block.settings.heading_tag }}">
          {{ block.settings.heading_text }}
        </{{ block.settings.heading_tag }}>
      </div>
    {% endif %}

    {% if block.settings.overlay_image_desktop %}
      <div class="ai-hero-overlay-image-{{ ai_gen_id }}">
        <picture>
          {% if block.settings.overlay_image_mobile %}
            <source
              media="(max-width: 749px)"
              srcset="{{ block.settings.overlay_image_mobile | image_url: width: block.settings.overlay_image_width_mobile }}"
            >
          {% endif %}
          <img
            src="{{ block.settings.overlay_image_desktop | image_url: width: block.settings.overlay_image_width_desktop }}"
            alt="{{ block.settings.overlay_image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.overlay_image_width_desktop }}"
            height="auto"
          >
        </picture>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero image with text",
  "tag": null,
  "settings": [
    {
  "type": "header",
  "content": "Visibility"
  },
  {
    "type": "checkbox",
    "id": "show_desktop",
    "label": "Show on desktop",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "show_mobile",
    "label": "Show on mobile",
    "default": true
  },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Heading text"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Text",
      "default": "Your heading here"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "text_vertical_position_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical position (desktop)",
      "default": 33
    },
    {
      "type": "range",
      "id": "text_vertical_position_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical position (mobile)",
      "default": 33
    },
    {
      "type": "header",
      "content": "Overlay image"
    },
    {
      "type": "image_picker",
      "id": "overlay_image_desktop",
      "label": "Desktop overlay image"
    },
    {
      "type": "image_picker",
      "id": "overlay_image_mobile",
      "label": "Mobile overlay image"
    },
    {
      "type": "range",
      "id": "overlay_image_width_desktop",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Width (desktop)",
      "default": 400
    },
    {
      "type": "range",
      "id": "overlay_image_width_mobile",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Width (mobile)",
      "default": 200
    }
  ],
  "presets": [
    {
      "name": "Hero image with text"
    }
  ]
}
{% endschema %}
