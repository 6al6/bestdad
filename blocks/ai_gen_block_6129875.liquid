{% doc %}
  @prompt
    Header segment, which can be toggled on or off for just one specific page and is not automatically added to all pages.
    The header has a slot for a logo on the left, and a central text in the middle.  The text is h1 but has options to size it and change font.
    The whole header segment has a padding between the logo/text and the border. It also has an optional border line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.show_border %}
      border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-page-header__logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    max-width: {{ block.settings.logo_max_width }}px;
  }

  .ai-page-header__logo-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-page-header__logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_max_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-page-header__logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 100px;
    max-height: 50px;
  }

  .ai-page-header__text-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    margin: 0;
    padding: 0 20px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-page-header-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-page-header__logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_max_width | times: 0.7 }}px;
    }

    .ai-page-header__logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_max_width | times: 0.7 }}px;
      height: 42px;
    }

    .ai-page-header__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
      padding: 0 10px;
    }
  }
{% endstyle %}

{% if block.settings.enable_header %}
  <div class="ai-page-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-page-header__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-page-header__logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <h1 class="ai-page-header__text-{{ ai_gen_id }}">
      {{ block.settings.header_text }}
    </h1>
  </div>
{% endif %}

{% schema %}
{
  "name": "Page header",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_header",
      "label": "Enable header",
      "default": true,
      "info": "Toggle this header on or off for this specific page"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Maximum width",
      "default": 150
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header text",
      "default": "Welcome to our store"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "prompt_n9"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#162317"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f4fbf2"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 30
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": true
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "default": "#162317"
    }
  ],
  "presets": [
    {
      "name": "Page header"
    }
  ]
}
{% endschema %}
