{% doc %}
  @prompt
    Create a button that has customizable color, shadow, shape, but it should be in the default pill shape of the whole team, and text inside of it. The text should be editable, and the button should link to a section somewhere below, so it needs to have linking. It also needs to be customizable regarding its position, x and y-axis, as well as its height and width. Also the text needs to be editable, as well as all functions need to be separate for mobile and desktop, except the, no, all functions. Also this button should be at the topmost layer of the whole section. The button is limited to this section only., add an outline option, thickness and color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  #sticky-buy-wrapper a {
    position: relative!important;
  }

  .ai-floating-button-{{ ai_gen_id }} {
    position: absolute;
    z-index: 9999;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  /*
  @media screen and (min-width: 750px) {
    .ai-floating-button-{{ ai_gen_id }} {
      visibility: hidden;
      pointer-events: none;
    }
  }
  */

  @media screen and (min-width: 750px) {
    .ai-floating-button-{{ ai_gen_id }} {
      left: {{ block.settings.desktop_x_position }}%;
      top: {{ block.settings.desktop_y_position }}%;
      width: {{ block.settings.desktop_width }}px;
      height: {{ block.settings.desktop_height }}px;
      background-color: {{ block.settings.desktop_bg_color }};
      color: {{ block.settings.desktop_text_color }};
      border-radius: {% if block.settings.desktop_shape == 'pill' %}9999px{% elsif block.settings.desktop_shape == 'rounded' %}0.5rem{% else %}0{% endif %};
      box-shadow: {{ block.settings.desktop_shadow_x }}px {{ block.settings.desktop_shadow_y }}px {{ block.settings.desktop_shadow_blur }}px {{ block.settings.desktop_shadow_color }};
      font-size: {{ block.settings.desktop_font_size }}px;
      border: {{ block.settings.desktop_outline_thickness }}px solid {{ block.settings.desktop_outline_color }};
    }

    .ai-floating-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.desktop_hover_bg_color }};
      color: {{ block.settings.desktop_hover_text_color }};
      transform: translateY(-2px);
      box-shadow: {{ block.settings.desktop_shadow_x }}px {{ block.settings.desktop_shadow_y | plus: 2 }}px {{ block.settings.desktop_shadow_blur | plus: 2 }}px {{ block.settings.desktop_shadow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-floating-button-{{ ai_gen_id }} {
      left: {{ block.settings.mobile_x_position }}%;
      top: {{ block.settings.mobile_y_position }}%;
      width: {{ block.settings.mobile_width }}px;
      height: {{ block.settings.mobile_height }}px;
      background-color: {{ block.settings.mobile_bg_color }};
      color: {{ block.settings.mobile_text_color }};
      border-radius: {% if block.settings.mobile_shape == 'pill' %}9999px{% elsif block.settings.mobile_shape == 'rounded' %}0.5rem{% else %}0{% endif %};
      box-shadow: {{ block.settings.mobile_shadow_x }}px {{ block.settings.mobile_shadow_y }}px {{ block.settings.mobile_shadow_blur }}px {{ block.settings.mobile_shadow_color }};
      font-size: {{ block.settings.mobile_font_size }}px;
      border: {{ block.settings.mobile_outline_thickness }}px solid {{ block.settings.mobile_outline_color }};
    }

    .ai-floating-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.mobile_hover_bg_color }};
      color: {{ block.settings.mobile_hover_text_color }};
      transform: translateY(-2px);
      box-shadow: {{ block.settings.mobile_shadow_x }}px {{ block.settings.mobile_shadow_y | plus: 2 }}px {{ block.settings.mobile_shadow_blur | plus: 2 }}px {{ block.settings.mobile_shadow_color }};
    }
  }
{% endstyle %}

{% assign product = all_products[block.settings.product] %}

<a
  href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% elsif product %}{{ product.url }}{% endif %}"
  class="ai-floating-button-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if product %}
    {% if product.available %}
      BUY NOW FOR
      {% if product.compare_at_price > product.price %}
        <span style="font-weight:700; margin-left:6px;">
          {{ product.price | money }}
        </span>
        <span style="text-decoration: line-through; margin-left:6px; opacity:.6;">
          {{ product.compare_at_price | money }}
        </span>
      {% else %}
        {{ product.price | money }}
      {% endif %}
    {% else %}
      SOLD OUT
    {% endif %}
  {% else %}
    Select product
  {% endif %}
</a>


