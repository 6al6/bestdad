    "landing_reasons_7imPJV": {
      "type": "landing-reasons",
      "blocks": {
        "card_EhME3T": {
          "type": "card",
          "settings": {
            "title": "28 answers\nto the question:\n“What are we doing today?”",
            "text": "Dad doesn’t need to be creative, an entertainer or a Pinterest wizard to pull off something his kid will remember forever. He opens the playbook, picks a mission and off they go. No Googling, no ChatGPT, no sixteen open tabs.",
            "card_color": "#ee614c",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        "card_QWgGUR": {
          "type": "card",
          "settings": {
            "title": "A shiny trophy for every adventure.",
            "text": "Dad and kid can play every day, but they rarely celebrate a game well played! A shiny sticker marks every completed mission, and the poster collects their wins. The kid sees what they’ve done together and the space left for what’s next. Dad finally has proof of his greatness.",
            "card_color": "#f72828",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        "card_BYFHEE": {
          "type": "card",
          "settings": {
            "title": "Funny before the first mission.",
            "text": "The humor is off the leash. The playbook has a proper laugh at dads and their parenting theories. Dad will crack up, at least as long as he thinks the jokes are about other dads.",
            "card_color": "#2b2d45",
            "text_color": "#fef1d5",
            "border_color": "#fef1d5"
          }
        },
        "card_hnMRcm": {
          "type": "card",
          "settings": {
            "title": "A gift that doesn’t end up in a drawer.",
            "text": "The tie waits for the next wedding. This kit goes into action the very first weekend. The gift is for Dad. He and the kid use it together. And everyone else at home gets a little peace and quiet.",
            "card_color": "#ffffff",
            "text_color": "#2b2d45",
            "border_color": "#2b2d45"
          }
        }
      },
