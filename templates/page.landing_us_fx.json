    "landing_gift_mydhzF": {
      "type": "landing-gift",
      "name": "Landing: Gift card",
      "settings": {
        "show_card": true,
        "image": "shopify://shop_images/Bestdad_Bundle_ENG_01_Cement.jpg",
        "title": "Bring something better than a bottle.",
        "subtitle": "For the new dad. The brother-in-law. The buddy with two kids and no plan.",
        "text": "<p>Every new dad gets a bottle. Then a mug. Give him 28 missions instead. He gets a script for every Saturday. His kid gets stories that start with: <strong>“</strong><em><strong>You know what me and Dad did…</strong></em><strong>”</strong> <strong>You get the credit for the idea.</strong></p>",
        "button_label": "Send him the kit",
        "button_link": "#product-offer-1",
        "button_note": "P.S.: Socks are still an option. We won’t judge. Out loud.",
        "note_title": "",
        "note_text": "",
        "note_author": "",
        "note_role": "",
        "background_color": "#ffffff",
