    "landing_faq_6W7fCC": {
      "type": "landing-faq",
      "blocks": {
        "gq_gift": {
          "type": "question",
          "settings": {
            "title": "Is it a good gift for my son or son-in-law?",
            "answer": "<p>Yes, if he enjoys time with his children but sometimes runs out of ideas. The kit gives him 28 missions with clear instructions, a poster and 28 stickers. It is practical and personal, and it doesn’t come with any advice attached.</p>"
          }
        },
        "gq_ages": {
          "type": "question",
          "settings": {
            "title": "What ages is it for?",
            "answer": "<p>Roughly ages 1–12. Not every mission suits every age, so the book helps him choose. With toddlers, Dad leads. Older children can help plan and make decisions.</p>"
          }
        },
        "gq_incl": {
          "type": "question",
          "settings": {
            "title": "What’s included in the kit?",
            "answer": "<p>The complete kit includes:</p><ul><li>A <strong>softcover</strong> book with <strong>28 tear-out missions</strong> and step-by-step instructions.</li><li><strong>28 gold-foiled trophy stickers</strong> for completed missions.</li><li>The <strong>Dad Achievement Poster</strong> to collect them.</li><li><strong>A letter from Santa</strong> in its special envelope.</li></ul>"
          }
        },
        "gq_advice": {
          "type": "question",
          "settings": {
            "title": "Is this a parenting advice book?",
            "answer": "<p>No. It never tells him what he is doing wrong. It’s a book to use: he chooses a mission, tears out the page, follows the steps and does it with the children.</p>"
          }
        },
        "gq_how": {
          "type": "question",
          "settings": {
            "title": "How do the missions, stickers and poster work together?",
            "answer": "<p>Dad and child choose a mission and do it together. When it’s done, the child awards Dad a gold sticker, which goes on the Dad Achievement Poster. The poster hangs where the child sees it every day, so they remember what they did and look forward to the next one.</p>"
          }
        },
        "gq_time": {
          "type": "question",
          "settings": {
            "title": "How long does a mission take?",
            "answer": "<p>Some are short, others take longer or need some preparation. Each mission lists the time, supplies and setup, so he can choose one that fits the day. There is no need to do them in order.</p>"
          }
        },
        "gq_grand": {
          "type": "question",
          "settings": {
            "title": "Can grandparents join in?",
            "answer": "<p>Of course. The book is written for dads, but grandparents, moms and other adults can take part. Dad keeps the title. Everyone can join the fun.</p>"
          }
        },
        "gq_remember": {
          "type": "question",
          "settings": {
            "title": "Will my grandchildren remember it?",
            "answer": "<p>We can’t promise which moments will stay with them. But doing something out of the ordinary together gives them a story, and the poster gives them a reason to tell it again. Often to their grandparents.</p>"
          }
        },
        "gq_repeat": {
          "type": "question",
          "settings": {
            "title": "Can missions be repeated?",
            "answer": "<p>Yes. The page is torn out once, but a favorite mission can be done as often as they like.</p>"
          }
        },
        "gq_supplies": {
          "type": "question",
          "settings": {
            "title": "Does he need special supplies?",
            "answer": "<p>Most missions use things found at home. Each one lists what is needed, so he can check before starting.</p>"
          }
        },
        "gq_safe": {
          "type": "question",
          "settings": {
            "title": "Are the missions safe?",
            "answer": "<p>Dad chooses activities that suit his child’s age and abilities, reads the instructions and supervises throughout. Anything with water, cooking, tools or small objects needs the right precautions. If a mission doesn’t suit the child or the space, he can adapt it or choose another.</p>"
          }
        },
        "gq_newdad": {
          "type": "question",
          "settings": {
            "title": "Is it suitable for a new dad?",
            "answer": "<p>Yes. First-time dads, experienced dads, stepdads and dads sharing custody can all use it. For a newborn, it’s a gift to grow into: many missions will be for later.</p>"
          }
        },
        "gq_read": {
          "type": "question",
          "settings": {
            "title": "Will he actually read it?",
            "answer": "<p>He doesn’t need to read it cover to cover. Each mission stands on its own page, so he only needs the instructions for the one he chooses. The book is written with humor, which helps.</p>"
          }
        },
        "gq_ship": {
          "type": "question",
          "settings": {
            "title": "Where is the book printed, how long is shipping, and what if I need to return it?",
            "answer": "<p>The book is <strong>printed in the EU</strong>. We ship internationally, including to the <strong>United States and Canada</strong>. Delivery times and shipping costs depend on the destination and are shown through our ordering process. See the <a href=\"https://bestdadbook.com/policies/shipping-policy\">Shipping Policy</a> for details. If you need the kit by a specific date, contact <a href=\"mailto:info@bestdadbook.com\">info@bestdadbook.com</a> before placing your order.</p><p>Changed your mind? Eligible unused, unopened kits can be returned under our <strong>30-day voluntary return policy</strong>, including sale purchases. For US and Canadian orders, returns are sent back to Slovenia at the customer’s expense. EU customers also have separate statutory withdrawal rights. See the full <a href=\"https://bestdadbook.com/policies/refund-policy\">Return Policy</a> for conditions, deadlines, and exceptions.</p>"
          }
        }
      },
